<Window x:Class="LumNotas.App.DialogoCambiosSinGuardar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cambios sin guardar"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" Background="White">

    <StackPanel Margin="28,24" MaxWidth="430">
        <TextBlock Text="La toma de notas tiene cambios sin guardar" FontSize="17" FontWeight="Bold"
                   Foreground="#111827" TextWrapping="Wrap"/>
        <TextBlock Margin="0,8,0,22" Foreground="#6B7280" FontSize="12" TextWrapping="Wrap"
                   Text="Si continúas sin guardar, lo anotado desde la última vez que guardaste se pierde."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BotonDescartar" Content="Continuar sin guardar" Click="AlDescartar"
                    Padding="18,9" Margin="0,0,10,0" Cursor="Hand"
                    Background="#E5E7EB" Foreground="#374151" BorderThickness="0"/>
            <Button x:Name="BotonGuardar" Content="Guardar cambios" Click="AlGuardar" IsDefault="True"
                    Padding="18,9" Cursor="Hand"
                    Background="#2563EB" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </StackPanel>
</Window>
