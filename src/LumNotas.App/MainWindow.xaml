<Window x:Class="LumNotas.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LumNotas.App.ViewModels"
        xmlns:local="clr-namespace:LumNotas.App"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="{Binding Titulo}" Height="820" Width="1280"
        MinHeight="520" MinWidth="620"
        FontFamily="Segoe UI" FontSize="13" Background="#F5F6F8">

    <Window.Resources>
        <local:EstadoAColorConverter x:Key="EstadoAColor"/>
        <local:FaltaAColorConverter x:Key="FaltaAColor"/>
        <BooleanToVisibilityConverter x:Key="BoolAVisible"/>
        <local:DesplazamientoAMargen x:Key="Desplazamiento"/>
        <local:AnchoDelIndice x:Key="AnchoIndice"/>

        <!--
            Caja de cartón con las solapas abiertas: «las muestras ya están aquí».
            Va dibujada como trazo y no como imagen para que se vea nítida a cualquier
            tamaño y tome el color de donde se ponga, que en la barra es blanco y en la
            tarjeta gris.
        -->
        <Geometry x:Key="IconoCaja">M1,3 H13 V13 H1 Z M1,6.5 H13 M7,3 V6.5</Geometry>

        <!-- Candado: las fechas de este trabajo están blindadas y no las mueve el arrastre.
             Mismo tamaño y mismo trazo que la caja, para que convivan en la tarjeta. -->
        <Geometry x:Key="IconoCandado">M2.5,6.5 H11.5 V13 H2.5 Z M4.5,6.5 V4.5 A2.5,2.5 0 0 1 9.5,4.5 V6.5</Geometry>

        <!--
            Iconos de la portada. Mismo lienzo de 14 y mismo trazo que la caja y el candado,
            para que todo el programa dibuje igual.

            Están para que las cuatro vistas de gestión —cuatro palabras abstractas— se
            distingan sin leerlas. En las recientes no hay ninguno: un icono repetido cinco
            veces no informa de nada y solo roba ancho al nombre.
        -->
        <Geometry x:Key="IconoCarpeta">M1,3.5 H5.5 L7,5.5 H13 V12 H1 Z</Geometry>
        <Geometry x:Key="IconoNuevo">M7,2.5 V11.5 M2.5,7 H11.5</Geometry>
        <Geometry x:Key="IconoTablero">M2,2 V12 M7,2 V12 M12,2 V12 M2,2 H12 M2,7 H7 M7,9.5 H12</Geometry>
        <Geometry x:Key="IconoCalendario">M1.5,3.5 H12.5 V12.5 H1.5 Z M1.5,6.5 H12.5 M4.5,1.5 V3.5 M9.5,1.5 V3.5</Geometry>
        <Geometry x:Key="IconoCarga">M1.5,12.5 H12.5 M3.5,12.5 V8 M7,12.5 V4.5 M10.5,12.5 V6.5</Geometry>
        <Geometry x:Key="IconoBuscar">M6,1.5 A4.5,4.5 0 1 1 5.99,1.5 Z M9.4,9.4 L12.8,12.8</Geometry>

        <!-- Caja de texto obligatoria: borde rojo y más grueso mientras esté vacía -->
        <Style x:Key="Obligatorio" TargetType="TextBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="BorderBrush" Value="#C9CDD4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E1E4E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!--
            Las dos pestañas de arriba mandan sobre las de proyecto, así que se distinguen:
            redondeadas como aquellas y en negrita la que está delante.
        -->
        <Style x:Key="PestanaPadre" TargetType="TabItem">
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Caja" CornerRadius="10,10,0,0" Margin="3,3,0,0" Padding="20,9"
                                Background="#DDE1E6" BorderBrush="#D2D7DD" BorderThickness="1,1,1,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Caja" Property="Background" Value="#E7EAEE"/>
                            </Trigger>
                            <!-- Después del anterior, para que la elegida gane al pasar por encima -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Caja" Property="Background" Value="#ECEEF1"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#111827"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Portada ===== -->
        <!--
            SISTEMA DE LA PORTADA (2026‑08‑06). Solo lo que usa esta pantalla; no hay
            sistema general y no se inventa uno para el resto de la aplicación.

            TRES TAMAÑOS DE TEXTO Y NINGUNO MÁS. Antes había nueve —26, 14, 13, 12,5, 12,
            11,5 y 11— y con eso la pantalla no podía tener jerarquía: nueve pesos son
            ninguno. Ahora: el nombre del programa, lo que se pulsa, y lo que acompaña.

            ESPACIADO EN 4/8: 4, 8, 12, 16, 24, 32. Nada intermedio.

            CONTRASTE. Los dos que fallaban AA están corregidos y anotados abajo. El
            gris suave es el más claro que pasa 4,5:1 sobre blanco (4,90:1); por debajo
            de ese no se baja.
        -->
        <sys:Double x:Key="TamTitulo">26</sys:Double>
        <sys:Double x:Key="TamAccion">14</sys:Double>
        <sys:Double x:Key="TamApoyo">12</sys:Double>

        <SolidColorBrush x:Key="TintaFuerte" Color="#111827"/>
        <!-- 4,90:1 sobre blanco. Sustituye a #9CA3AF, que daba 2,54:1 y suspendía AA -->
        <SolidColorBrush x:Key="TintaSuave" Color="#6B7280"/>
        <!-- 6,20:1 sobre el gris de la píldora de versión, donde #6B7280 daba 4,06:1 -->
        <SolidColorBrush x:Key="TintaSobreGris" Color="#4B5563"/>
        <SolidColorBrush x:Key="AzulNotas" Color="#2563EB"/>
        <SolidColorBrush x:Key="VerdeGestion" Color="#0F766E"/>
        <SolidColorBrush x:Key="BordeSuave" Color="#D8DCE2"/>

        <!--
            El foco, que antes no existía. Los estilos de la portada rehacían la plantilla
            entera y se quedaban sin el adorno punteado de WPF, así que quien navegue con
            el tabulador no veía dónde estaba: fallo de WCAG 2.4.7.

            Se dibuja como anillo propio encima de la caja. Contra el azul da 3,47:1 y
            contra el blanco 17,8:1, ambos por encima del 3:1 que pide un elemento de
            interfaz (WCAG 1.4.11).
        -->
        <SolidColorBrush x:Key="AnilloFoco" Color="#111827"/>

        <!-- Cada zona de la portada: la de tomar notas y la de gestionar -->
        <Style x:Key="ZonaInicio" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <!-- Rótulo de zona, con su barrita de color delante -->
        <Style x:Key="RotuloZona" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="{StaticResource TamApoyo}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!--
            LOS TRES PESOS DE LA PORTADA. Uno por nivel y ninguno más, para que el peso
            visual signifique algo:

              · Primaria  — relleno de color. **Una por zona.** El laboratorio decidió que
                            tomar notas y gestionar pesan lo mismo (DD‑80), así que forzar
                            una sola en toda la pantalla mentiría sobre para quién es el
                            programa. La regla se aplica dentro de cada zona.
              · Secundaria — contorno. Lo frecuente que no es la primaria.
              · Terciaria  — sin caja hasta que se pasa por encima. Lo esporádico.

            Los tres declaran los CINCO estados. Antes declaraban uno —encima— porque
            sustituían la plantilla del estilo global y perdían los suyos sin avisar.
            Falta a propósito el sexto, *cargando*: ninguna acción de esta pantalla tarda
            lo suficiente. Abrir levanta el diálogo de Windows en el acto y el escaneo
            tiene su barra de progreso ya en la vista de gestión.

            Altura mínima 44 en las tres: es el objetivo táctil de WCAG 2.5.8. Las filas
            de recientes medían 25.
        -->
        <Style x:Key="AccionPrimaria" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AzulNotas}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Caja" CornerRadius="10" Padding="16,12"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            </Border>
                            <Border x:Name="Foco" CornerRadius="10" BorderThickness="2"
                                    BorderBrush="{StaticResource AnilloFoco}"
                                    IsHitTestVisible="False" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Caja" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Caja" Property="Opacity" Value="0.72"/>
                                <Setter TargetName="Caja" Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Foco" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Caja" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccionSecundaria" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Caja" CornerRadius="8" Padding="12,8" Background="White"
                                    BorderBrush="{StaticResource BordeSuave}" BorderThickness="1">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Border>
                            <Border x:Name="Foco" CornerRadius="8" BorderThickness="2"
                                    BorderBrush="{StaticResource AnilloFoco}"
                                    IsHitTestVisible="False" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Caja" Property="Background" Value="#F3F6FB"/>
                                <Setter TargetName="Caja" Property="BorderBrush" Value="#9DB4E8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Caja" Property="Background" Value="#E7EDFA"/>
                                <Setter TargetName="Caja" Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Foco" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Caja" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccionTerciaria" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Caja" CornerRadius="8" Padding="12,8"
                                    Background="Transparent" BorderThickness="1"
                                    BorderBrush="Transparent">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Border>
                            <Border x:Name="Foco" CornerRadius="8" BorderThickness="2"
                                    BorderBrush="{StaticResource AnilloFoco}"
                                    IsHitTestVisible="False" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Caja" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Caja" Property="Background" Value="#E5E7EB"/>
                                <Setter TargetName="Caja" Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Foco" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Caja" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Acceso directo a una de las vistas de gestión. Mismo truco que la tarjeta de
            norma: WPF no redondea un Button, así que la plantilla se rehace sobre un
            Border. Ocupa todo el ancho de su zona porque son una lista, no una rejilla.
        -->






        <!-- Selector de vista del tablero. La activa va en negrita y con fondo, igual
             que las pestañas: es el mismo gesto de «aquí estás». -->
        <!--
            El fondo y el color se ponen en el propio botón y la plantilla los toma con
            TemplateBinding. Antes los cambiaba un DataTrigger de dentro de la plantilla
            apuntando a un elemento con nombre, y nunca llegaba a saltar: la vista activa
            no se distinguía de las demás.
        -->
        <Style x:Key="Vista" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="7" Background="{TemplateBinding Background}" Padding="14,6">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
                <!-- Tag lleva si esta vista es la que se está mostrando -->
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="#E0E7FF"/>
                    <Setter Property="Foreground" Value="#1E3A8A"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- El código del servicio, que abre su toma de notas al pulsarlo -->
        <Style x:Key="EnlaceProyecto" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#1D4ED8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Texto" Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   TextTrimming="CharacterEllipsis"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Texto" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            La tarjeta de una familia sobre la línea de tiempo. Al pulsarla se planifica.
            Las esquinas las pone el modelo de vista: entre dos familias del mismo trabajo
            van a escuadra, para que se lean como un tren y no como pastillas sueltas.
        -->
        <Style x:Key="BarraPlan" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Caja" CornerRadius="{Binding Esquinas}"
                                ClipToBounds="True"
                                Background="{TemplateBinding Background}">
                            <!--
                                Lo hecho, aclarado sobre el color del estado. El texto no cabe
                                en una barra de dos semanas ni con el zoom al máximo, así que
                                el porcentaje se dice también con la forma, que no gasta ancho.

                                Columnas «*» y no anchos en píxeles: se reparten solas mientras
                                se arrastra la barra, sin recalcular nada en cada latido. El
                                relleno va debajo del texto, no al lado.
                            -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding Hecho}"/>
                                    <ColumnDefinition Width="{Binding Queda}"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#38FFFFFF"
                                        CornerRadius="{Binding EsquinasHechas}"/>
                                <ContentPresenter Grid.ColumnSpan="2" Margin="8,0"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Caja" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Una fila de campo: etiqueta a la izquierda, una celda por muestra -->
        <DataTemplate DataType="{x:Type vm:CampoViewModel}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding EtiquetaConUnidad}" VerticalAlignment="Center"
                           TextWrapping="Wrap" Foreground="#3A3F45" Margin="0,0,12,0"/>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Celdas}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Los campos booleanos («No blando», «No aislante») son casillas -->
                            <Grid Width="150" Margin="0,0,8,0">
                                <TextBox Text="{Binding Texto, UpdateSourceTrigger=LostFocus}"
                                         Visibility="{Binding EsTexto, Converter={StaticResource BoolAVisible}}"/>
                                <CheckBox IsChecked="{Binding Marcado}" HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Visibility="{Binding EsBooleano, Converter={StaticResource BoolAVisible}}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </DataTemplate>

        <!-- Grupo repetido: cada elemento en su bloque, con subtítulo y línea separadora -->
        <DataTemplate DataType="{x:Type vm:GrupoRepetidoViewModel}">
            <StackPanel Margin="0,10,0,4">
                <Grid Visibility="{Binding TieneMuestras, Converter={StaticResource BoolAVisible}}"
                      Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Muestras}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Width="150" Margin="0,0,8,0"
                                           FontWeight="SemiBold" Foreground="#6B7280" FontSize="11"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <ItemsControl ItemsSource="{Binding Elementos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"
                                    Padding="0,0,0,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold"
                                               Foreground="#374151" Margin="0,0,0,5"/>
                                    <ItemsControl ItemsSource="{Binding Campos}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="{Binding TextoAnadir}" Command="{Binding Anadir}"
                        HorizontalAlignment="Left" Padding="12,5" Cursor="Hand"
                        Background="#F3F4F6" BorderBrush="#C9CDD4" Foreground="#1F2937"
                        Visibility="{Binding Ampliable, Converter={StaticResource BoolAVisible}}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ChecklistViewModel}">
            <StackPanel Margin="0,8,0,4">
                <TextBlock Text="{Binding Etiqueta}" FontWeight="SemiBold" Margin="0,0,0,4"
                           Visibility="{Binding TieneEtiqueta, Converter={StaticResource BoolAVisible}}"/>
                <TextBlock Text="{Binding Nota}" FontStyle="Italic" Foreground="#6B7280"
                           TextWrapping="Wrap" Margin="0,0,0,4"
                           Visibility="{Binding TieneNota, Converter={StaticResource BoolAVisible}}"/>
                <ItemsControl ItemsSource="{Binding Opciones}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Marcada}" Content="{Binding Etiqueta}"
                                      Margin="0,2" VerticalContentAlignment="Center"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- Casilla suelta de un conjunto (grados IP, partes -2) -->
        <DataTemplate DataType="{x:Type vm:SeleccionViewModel}">
            <CheckBox IsChecked="{Binding Marcada}" Content="{Binding Etiqueta}" Margin="0,2,16,2"/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:GrupoViewModel}">
            <Border Style="{StaticResource Tarjeta}">
                <StackPanel>
                    <TextBlock Text="{Binding Titulo}" FontWeight="Bold" FontSize="15"
                               Foreground="#1F2937" Margin="0,0,0,6"/>

                    <!-- El «no aplica» va justo bajo el título: es lo primero que se decide -->
                    <ItemsControl ItemsSource="{Binding ChecklistsNa}" Margin="0,0,0,6"
                                  Visibility="{Binding TieneNa, Converter={StaticResource BoolAVisible}}"/>

                    <ItemsControl ItemsSource="{Binding Notas}"
                                  Visibility="{Binding TieneNotas, Converter={StaticResource BoolAVisible}}"
                                  Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontStyle="Italic"
                                           Foreground="#6B7280" Margin="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Exenciones («La luminaria NO tiene tornillos»): tras las notas y
                         antes de los campos, porque deciden si hay algo que rellenar -->
                    <ItemsControl ItemsSource="{Binding ChecklistsExencion}" Margin="0,0,0,8"
                                  Visibility="{Binding TieneExencion, Converter={StaticResource BoolAVisible}}"/>

                    <!-- Condiciones propias del subapartado, cuando las declara -->
                    <StackPanel Visibility="{Binding TieneAmbiente, Converter={StaticResource BoolAVisible}}"
                                IsEnabled="{Binding Aplica}"
                                Margin="0,0,0,10">
                        <TextBlock Text="Condiciones del ensayo" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding Ambiente}"/>
                    </StackPanel>

                    <!-- Cabecera de columnas: a qué muestra corresponde cada una -->
                    <Grid Visibility="{Binding TieneMuestras, Converter={StaticResource BoolAVisible}}"
                          Margin="0,4,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Muestras}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Width="150" Margin="0,0,8,0"
                                               FontWeight="SemiBold" Foreground="#6B7280" FontSize="11"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- Con el subapartado marcado como no aplicable, sus datos se
                         desactivan; las casillas que lo deciden quedan activas -->
                    <ItemsControl ItemsSource="{Binding Campos}" IsEnabled="{Binding Aplica}"/>
                    <ItemsControl ItemsSource="{Binding Repetidos}" IsEnabled="{Binding Aplica}"/>
                    <ItemsControl ItemsSource="{Binding Checklists}" IsEnabled="{Binding Aplica}"/>

                    <StackPanel Visibility="{Binding TieneComentarios, Converter={StaticResource BoolAVisible}}"
                                IsEnabled="{Binding Aplica}"
                                Margin="0,10,0,0">
                        <TextBlock Text="Comentarios" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Comentarios.Texto, UpdateSourceTrigger=LostFocus}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--
            Panel de planificación. Enseña lo que hay en el .lmnlab bajo «planificacion»:
            fechas, muestras, estado, grupo e importe. Está aquí para no tener que irse a
            gestión con el ensayo delante.

            NO SALE EN EL INFORME. ExportadorDeInforme no conoce la planificación —cero
            referencias— y esto no lo cambia: son fechas de gestión y dinero, no datos de
            ensayo, y no pintan nada en un documento que se firma.
        -->
        <DataTemplate DataType="{x:Type vm:PlanificacionViewModel}">
            <StackPanel>
                <TextBlock Text="Planificación" FontSize="21" FontWeight="Bold"
                           Foreground="#111827" Margin="0,0,0,4"/>
                <TextBlock Text="Lo que dice la planificación de esta TdN. No se imprime en el informe."
                           Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,14" TextWrapping="Wrap"/>

                <!-- Sin fichero no hay dónde leer ni dónde escribir -->
                <Border Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4"
                        Padding="12,9" Margin="0,0,0,14"
                        Visibility="{Binding SinProyecto, Converter={StaticResource BoolAVisible}}">
                    <TextBlock TextWrapping="Wrap" Foreground="#4B5563"
                               Text="La toma de notas todavía no se ha guardado. En cuanto tenga fichero, aquí saldrá su planificación."/>
                </Border>

                <StackPanel Visibility="{Binding HayProyecto, Converter={StaticResource BoolAVisible}}">
                    <!-- Lo que hay que saber sin buscarlo: retraso, muestras sin llegar, archivado -->
                    <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4"
                            Padding="12,9" Margin="0,0,0,14"
                            Visibility="{Binding HayAviso, Converter={StaticResource BoolAVisible}}">
                        <TextBlock Text="{Binding Aviso}" TextWrapping="Wrap" Foreground="#92400E"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <Border Background="#FEE2E2" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="4"
                            Padding="12,9" Margin="0,0,0,14"
                            Visibility="{Binding HayMensaje, Converter={StaticResource BoolAVisible}}">
                        <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" Foreground="#991B1B"/>
                    </Border>

                    <Border Style="{StaticResource Tarjeta}">
                        <StackPanel>
                            <TextBlock Text="Fechas" FontWeight="Bold" FontSize="15"
                                       Foreground="#1F2937" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Inicio" Margin="0,0,0,8" Foreground="#374151"/>
                                <TextBlock Grid.Column="1" Text="{Binding Inicio}" Margin="0,0,0,8"
                                           FontWeight="SemiBold" Foreground="#111827"/>

                                <TextBlock Grid.Row="1" Text="Fin" Margin="0,0,0,8" Foreground="#374151"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Fin}" Margin="0,0,0,8"
                                           FontWeight="SemiBold" Foreground="#111827"/>

                                <TextBlock Grid.Row="2" Text="Recepción de muestras" Foreground="#374151"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RecepcionMuestras}"
                                           FontWeight="SemiBold" Foreground="#111827"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Tarjeta}">
                        <StackPanel>
                            <TextBlock Text="Estado de la TdN" FontWeight="Bold" FontSize="15"
                                       Foreground="#1F2937" Margin="0,0,0,4"/>
                            <!-- Lo único que se edita aquí. Se escribe en el fichero al
                                 elegirlo, igual que desde el calendario. -->
                            <TextBlock Text="Se guarda al elegirlo. Lo demás se cambia en «Planificar»."
                                       Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,10"
                                       TextWrapping="Wrap"/>
                            <ComboBox ItemsSource="{Binding Estados}" SelectedItem="{Binding EstadoElegido}"
                                      Width="220" HorizontalAlignment="Left" Padding="6,5"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Archivado" Margin="0,0,0,8" Foreground="#374151"/>
                                <TextBlock Grid.Column="1" Text="{Binding Archivado}" Margin="0,0,0,8"
                                           FontWeight="SemiBold" Foreground="#111827"/>

                                <!-- El mismo rótulo que en los dos diálogos que lo editan: es
                                     el mismo dato, y aquí solo se lee. -->
                                <TextBlock Grid.Row="1" Text="Importe de la TdN (familia)" Margin="0,0,0,8"
                                           Foreground="#374151"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Importe}" Margin="0,0,0,8"
                                           FontWeight="SemiBold" Foreground="#111827"/>

                                <!-- El grupo solo si lo hay: la mayoría de servicios no van enlazados -->
                                <TextBlock Grid.Row="2" Text="Trabajo (agrupación)" Foreground="#374151"
                                           Visibility="{Binding HayGrupo, Converter={StaticResource BoolAVisible}}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Grupo}"
                                           FontWeight="SemiBold" Foreground="#111827"
                                           Visibility="{Binding HayGrupo, Converter={StaticResource BoolAVisible}}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <!-- Al calendario, buscando las once primeras del código: el mismo
                             rótulo con el que el calendario dibuja cada barra. -->
                        <Button Content="Ver en el calendario"
                                Command="{Binding VerEnCalendario}"
                                Padding="16,8" Cursor="Hand" Margin="0,0,10,0"
                                Background="#0F766E" Foreground="White" BorderThickness="0"
                                ToolTip="Abre gestión en el calendario buscando esta TdN"/>

                        <Button Content="Planificar" Command="{Binding Planificar}"
                                Padding="16,8" Cursor="Hand"
                                ToolTip="Cambiar fechas, importe y agrupación"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Panel de cabecera del proyecto -->
        <DataTemplate DataType="{x:Type vm:ProyectoViewModel}">
            <StackPanel>
                <TextBlock Text="{Binding Encabezado}" FontSize="21" FontWeight="Bold"
                           Foreground="#111827" Margin="0,0,0,14"/>

                <!-- Hasta que la cabecera esté completa, las secciones de ensayo no aparecen -->
                <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4"
                        Padding="12,9" Margin="0,0,0,14"
                        Visibility="{Binding HayQueFalta, Converter={StaticResource BoolAVisible}}">
                    <TextBlock Text="{Binding QueFalta}" TextWrapping="Wrap" Foreground="#92400E"
                               FontWeight="SemiBold"/>
                </Border>

                <Border Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <TextBlock Text="Identificación" FontWeight="Bold" FontSize="15"
                                   Foreground="#1F2937" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>

                            <!-- El que da nombre al fichero. Va el primero porque es el que
                                 se teclea: el de servicio sale solo de sus nueve primeras. -->
                            <TextBlock Text="Código de la toma de notas *" VerticalAlignment="Top" Margin="0,9,0,4"
                                       TextWrapping="Wrap"
                                       Foreground="{Binding FaltaCodigoTomaDeNotas, Converter={StaticResource FaltaAColor},
                                                    ConverterParameter=#111827}"/>
                            <StackPanel Grid.Column="1" Margin="0,4">
                                <TextBox Width="240" HorizontalAlignment="Left"
                                         Style="{StaticResource Obligatorio}"
                                         Text="{Binding CodigoTomaDeNotas, UpdateSourceTrigger=LostFocus}"
                                         BorderBrush="{Binding FaltaCodigoTomaDeNotas, Converter={StaticResource FaltaAColor}}"/>
                                <TextBlock Text="Ejemplo: TECNO260201-00" FontSize="11" Foreground="#9CA3AF"
                                           Margin="0,3,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="Código de servicio *" VerticalAlignment="Top" Margin="0,9,0,4"
                                       TextWrapping="Wrap"
                                       Foreground="{Binding FaltaCodigo, Converter={StaticResource FaltaAColor},
                                                    ConverterParameter=#111827}"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,4">
                                <TextBox Width="240" HorizontalAlignment="Left"
                                         Style="{StaticResource Obligatorio}"
                                         Text="{Binding CodigoServicio, UpdateSourceTrigger=LostFocus}"
                                         BorderBrush="{Binding FaltaCodigo, Converter={StaticResource FaltaAColor}}"/>
                                <TextBlock Text="Ejemplo: TECNO2602" FontSize="11" Foreground="#9CA3AF"
                                           Margin="0,3,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Text="Técnico 1 *" VerticalAlignment="Center" Margin="0,4"
                                       Foreground="{Binding FaltaTecnico1, Converter={StaticResource FaltaAColor},
                                                    ConverterParameter=#111827}"/>
                            <!-- Se elige de la lista del laboratorio; escribirlo a mano producía
                                 la misma persona con tres grafías. Empieza vacío a propósito. -->
                            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,4" Width="240"
                                      HorizontalAlignment="Left" BorderThickness="2"
                                      ItemsSource="{Binding Tecnicos}"
                                      SelectedItem="{Binding Tecnico1}"
                                      BorderBrush="{Binding FaltaTecnico1, Converter={StaticResource FaltaAColor}}"/>

                            <TextBlock Grid.Row="3" Text="Técnico 2" VerticalAlignment="Center" Margin="0,4"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,4" Width="240"
                                      HorizontalAlignment="Left"
                                      ItemsSource="{Binding Tecnicos}"
                                      SelectedItem="{Binding Tecnico2}"/>

                            <TextBlock Grid.Row="4" Text="Nº de muestras *" VerticalAlignment="Center" Margin="0,4"
                                       Foreground="{Binding FaltaMuestras, Converter={StaticResource FaltaAColor},
                                                    ConverterParameter=#111827}"/>
                            <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,4" Width="80" HorizontalAlignment="Left"
                                      BorderThickness="2"
                                      ItemsSource="{Binding OpcionesMuestras}"
                                      SelectedItem="{Binding NumeroMuestras}"
                                      BorderBrush="{Binding FaltaMuestras, Converter={StaticResource FaltaAColor}}"/>

                            <!-- Arranca vacía: hay que elegir, como el nº de muestras -->
                            <TextBlock Grid.Row="5" Text="Clase *" VerticalAlignment="Center" Margin="0,4"
                                       Visibility="{Binding MuestraClase, Converter={StaticResource BoolAVisible}}"
                                       Foreground="{Binding FaltaClase, Converter={StaticResource FaltaAColor},
                                                    ConverterParameter=#111827}"/>
                            <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,4" Width="80" HorizontalAlignment="Left"
                                      BorderThickness="2"
                                      Visibility="{Binding MuestraClase, Converter={StaticResource BoolAVisible}}"
                                      ItemsSource="{Binding Clases}" SelectedItem="{Binding Clase}"
                                      BorderBrush="{Binding FaltaClase, Converter={StaticResource FaltaAColor}}"/>

                            <TextBlock Grid.Row="6" Text="Ta (ºC) *" VerticalAlignment="Center" Margin="0,4"
                                       Foreground="{Binding FaltaTa, Converter={StaticResource FaltaAColor},
                                                    ConverterParameter=#111827}"/>
                            <TextBox Grid.Row="6" Grid.Column="1" Margin="0,4" Width="80" HorizontalAlignment="Left"
                                     Style="{StaticResource Obligatorio}"
                                     Text="{Binding Ta, UpdateSourceTrigger=LostFocus}"
                                     BorderBrush="{Binding FaltaTa, Converter={StaticResource FaltaAColor}}"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- Identificación de las muestras: el número es editable y renumera las de debajo -->
                <Border Style="{StaticResource Tarjeta}"
                        Visibility="{Binding HayMuestras, Converter={StaticResource BoolAVisible}}">
                    <StackPanel>
                        <TextBlock Text="Identificación de las muestras" FontWeight="Bold" FontSize="15"
                                   Foreground="#1F2937" Margin="0,0,0,4"/>
                        <TextBlock Foreground="#6B7280" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="Al cambiar un número, las muestras siguientes se renumeran consecutivamente."/>
                        <ItemsControl ItemsSource="{Binding Muestras}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Etiqueta}" VerticalAlignment="Center"
                                                   Foreground="#3A3F45"/>
                                        <TextBox Grid.Column="1" Width="70" Margin="0,0,12,0"
                                                 Text="{Binding Numero, UpdateSourceTrigger=LostFocus}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Identificador}"
                                                   VerticalAlignment="Center" FontFamily="Consolas"
                                                   Foreground="#1F2937"/>

                                        <!-- Atajo: una luminaria ordinaria es IP20 -->
                                        <CheckBox Grid.Column="3" Content="Luminaria ordinaria"
                                                  IsChecked="{Binding Ordinaria}"
                                                  VerticalAlignment="Center" Margin="0,0,16,0" FontSize="11"
                                                  Visibility="{Binding TieneOrdinaria,
                                                               Converter={StaticResource BoolAVisible}}"/>

                                        <!-- Grado IP objetivo de esta muestra, cuando la
                                             norma lo pide por muestra (60529) -->
                                        <ItemsControl Grid.Column="4" ItemsSource="{Binding GradosIp}"
                                                      Visibility="{Binding TieneGradosIp,
                                                                   Converter={StaticResource BoolAVisible}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Titulo}" VerticalAlignment="Center"
                                                                   FontSize="11" Margin="0,0,4,0"
                                                                   Foreground="{Binding Falta,
                                                                                Converter={StaticResource FaltaAColor},
                                                                                ConverterParameter=#6B7280}"/>
                                                        <ComboBox Width="82" BorderThickness="2"
                                                                  ItemsSource="{Binding Opciones}"
                                                                  SelectedItem="{Binding Valor}"
                                                                  BorderBrush="{Binding Falta,
                                                                                Converter={StaticResource FaltaAColor}}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Tarjeta}"
                        Visibility="{Binding MuestraPartes2, Converter={StaticResource BoolAVisible}}">
                    <StackPanel>
                        <TextBlock Text="{Binding EtiquetaPartes2}" FontWeight="Bold" FontSize="15"
                                   Margin="0,0,0,10"
                                   Foreground="{Binding FaltaPartes2, Converter={StaticResource FaltaAColor},
                                                ConverterParameter=#1F2937}"/>
                        <ItemsControl ItemsSource="{Binding Partes2}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Campos propios de la norma: Tc y clasificación del módulo en la 62031,
                     grado IK en la 62262. En luminarias la lista está vacía. -->
                <ItemsControl ItemsSource="{Binding CamposExtra}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Tarjeta}"
                                    Visibility="{Binding Visible, Converter={StaticResource BoolAVisible}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Etiqueta}" FontWeight="Bold" FontSize="15"
                                               Margin="0,0,0,4"
                                               Foreground="{Binding Falta, Converter={StaticResource FaltaAColor},
                                                            ConverterParameter=#1F2937}"/>
                                    <TextBlock Text="{Binding Nota}" Foreground="#6B7280" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,0,0,6"
                                               Visibility="{Binding HayNota, Converter={StaticResource BoolAVisible}}"/>

                                    <TextBox Width="120" HorizontalAlignment="Left" Margin="0,6,0,0"
                                             Style="{StaticResource Obligatorio}"
                                             Text="{Binding Texto, UpdateSourceTrigger=LostFocus}"
                                             BorderBrush="{Binding Falta, Converter={StaticResource FaltaAColor}}"
                                             Visibility="{Binding EsNumero, Converter={StaticResource BoolAVisible}}"/>

                                    <ComboBox Width="240" HorizontalAlignment="Left" Margin="0,6,0,0"
                                              BorderThickness="2"
                                              ItemsSource="{Binding Opciones}"
                                              SelectedItem="{Binding Seleccionada}"
                                              BorderBrush="{Binding Falta, Converter={StaticResource FaltaAColor}}"
                                              Visibility="{Binding EsUnica, Converter={StaticResource BoolAVisible}}"/>

                                    <ItemsControl ItemsSource="{Binding Marcas}" Margin="0,6,0,0"
                                                  Visibility="{Binding EsMultiple, Converter={StaticResource BoolAVisible}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Otras normas del mismo servicio. Las lleva el documento y la cabecera
                     las recibe, para no depender de dónde esté colgada la pantalla. -->
                <Border Style="{StaticResource Tarjeta}"
                        Visibility="{Binding HayNormasAnadibles, Converter={StaticResource BoolAVisible}}">
                    <StackPanel>
                        <TextBlock Text="Otras normas de esta TdN" FontWeight="Bold" FontSize="15"
                                   Foreground="#1F2937" Margin="0,0,0,4"/>
                        <TextBlock Text="Sus apartados se añaden al final del índice y salen también en el informe."
                                   Foreground="#6B7280" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding NormasAnadibles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Titulo}" IsChecked="{Binding Activa}"
                                              Margin="0,0,0,6"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Laboratorios de fuera. Lo normal es ninguno, así que la tarjeta está
                     siempre pero vacía: se rellena solo cuando hay algo que contar. -->
                <Border Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <TextBlock Text="Otros colaboradores" FontWeight="Bold" FontSize="15"
                                   Foreground="#1F2937" Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#6B7280" FontSize="12" Margin="0,0,0,10"
                                   Text="Laboratorios de fuera que hayan hecho parte del ensayo. Opcional; se pueden añadir los que hagan falta."/>

                        <ItemsControl ItemsSource="{Binding Colaboradores}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Laboratorio" FontSize="11" Foreground="#9CA3AF"
                                                       Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding Laboratorio, UpdateSourceTrigger=LostFocus}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                            <!-- Las dos cosas juntas y a propósito: para una auditoría,
                                                 «fotobiología — no tenemos cámara» explica una
                                                 subcontratación; «fotobiología» a secas, no. -->
                                            <TextBlock Text="Ensayo y motivo" FontSize="11" Foreground="#9CA3AF"
                                                       Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding EnsayoYMotivo, UpdateSourceTrigger=LostFocus}"
                                                     TextWrapping="Wrap" AcceptsReturn="True"/>
                                        </StackPanel>

                                        <Button Grid.Column="2" Content="✕" Command="{Binding Quitar}"
                                                Style="{StaticResource BotonIcono}"
                                                Width="30" Height="30" VerticalAlignment="Bottom"
                                                Cursor="Hand" Background="Transparent" BorderThickness="0"
                                                Foreground="#6B7280" ToolTip="Quitar este colaborador"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="Añadir laboratorio externo" Command="{Binding AnadirColaborador}"
                                Padding="14,7" Cursor="Hand" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- Panel de un apartado de ensayo -->
        <DataTemplate DataType="{x:Type vm:BloqueViewModel}">
            <StackPanel>
                <TextBlock Text="{Binding Encabezado}" FontSize="21" FontWeight="Bold"
                           Foreground="#111827" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding Seccion}" Foreground="#6B7280" Margin="0,0,0,14"/>

                <CheckBox Content="Este apartado no aplica (N/A)" IsChecked="{Binding NoAplica}"
                          Margin="0,0,0,14" FontWeight="SemiBold"
                          Visibility="{Binding PuedeSerNa, Converter={StaticResource BoolAVisible}}"/>

                <!-- Si una regla de este apartado falla, se dice aquí en vez de morir -->
                <Border Background="#FEE2E2" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="4"
                        Padding="12,8" Margin="0,0,0,14"
                        Visibility="{Binding HayFalloDeRegla, Converter={StaticResource BoolAVisible}}">
                    <TextBlock Text="{Binding FalloDeRegla}" TextWrapping="Wrap" Foreground="#991B1B"/>
                </Border>

                <ItemsControl ItemsSource="{Binding Avisos}"
                              Visibility="{Binding HayAvisos, Converter={StaticResource BoolAVisible}}"
                              Margin="0,0,0,14">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1"
                                    CornerRadius="4" Padding="12,8" Margin="0,0,0,6">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#92400E"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Con el apartado marcado como N/A todo su contenido se desactiva: la
                     casilla de N/A queda fuera para poder volver atrás -->
                <Border Style="{StaticResource Tarjeta}"
                        IsEnabled="{Binding Aplica}"
                        Visibility="{Binding TieneAmbiente, Converter={StaticResource BoolAVisible}}">
                    <StackPanel>
                        <TextBlock Text="Condiciones del ensayo" FontWeight="Bold" FontSize="15"
                                   Foreground="#1F2937" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding Ambiente}"/>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Grupos}" IsEnabled="{Binding Aplica}"/>

                <!-- Equipos utilizados, del catálogo del laboratorio -->
                <Border Style="{StaticResource Tarjeta}"
                        IsEnabled="{Binding Aplica}"
                        Visibility="{Binding TieneEquipos, Converter={StaticResource BoolAVisible}}">
                    <StackPanel>
                        <TextBlock Text="Equipos utilizados" FontWeight="Bold" FontSize="15"
                                   Foreground="#1F2937" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding TituloEquipos}" Foreground="#6B7280" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding NotasEquipos}" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontStyle="Italic"
                                               Foreground="#6B7280" Margin="0,1"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Equipos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!--
                                        Mode=OneWay explícito: Run.Text enlaza en dos sentidos
                                        por defecto y estas propiedades son de solo lectura,
                                        lo que hacía fallar la plantilla al dibujarla.
                                    -->
                                    <CheckBox IsChecked="{Binding Utilizado}" Margin="0,3"
                                              VerticalContentAlignment="Center">
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="{Binding Codigo, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text=" | "/>
                                            <Run Text="{Binding Descripcion, Mode=OneWay}" Foreground="#4B5563"/>
                                        </TextBlock>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Margin="0,10,0,0"
                                    Visibility="{Binding PermiteOtrosEquipos, Converter={StaticResource BoolAVisible}}">
                            <TextBlock Text="Otros equipos" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding OtrosEquipos.Texto, UpdateSourceTrigger=LostFocus}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Comentarios del apartado: 54 campos en el Excel original -->
                <Border Style="{StaticResource Tarjeta}"
                        IsEnabled="{Binding Aplica}"
                        Visibility="{Binding TieneComentarios, Converter={StaticResource BoolAVisible}}">
                    <StackPanel>
                        <TextBlock Text="Comentarios" FontWeight="Bold" FontSize="15"
                                   Foreground="#1F2937" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding Comentarios.Texto, UpdateSourceTrigger=LostFocus}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
        <!-- ===== Contenido de cada pestaña ===== -->

                    <DataTemplate DataType="{x:Type vm:DocumentoViewModel}">
                      <Grid>
                        <!-- Una pestaña enseña su proyecto o, si está recién abierta,
                             la portada para elegir con qué norma se empieza -->
                        <Grid Visibility="{Binding HayProyecto, Converter={StaticResource BoolAVisible}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

        <!-- Cabecera del proyecto abierto -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E1E4E8" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Pliega el índice de secciones para dejar sitio al formulario -->
                <Button Command="{Binding AlternarIndice}" Style="{StaticResource BotonIcono}"
                        Width="34" Height="34" Margin="0,0,14,0"
                        VerticalAlignment="Center" Cursor="Hand" FontSize="17"
                        Background="Transparent" Foreground="#374151" BorderBrush="#D1D5DB" BorderThickness="1"
                        Content="{Binding IconoIndice}" ToolTip="{Binding TituloIndice}"/>

                <!-- El título se recorta con puntos suspensivos, no crece: sin esto, con
                     la ventana estrecha se metía por encima del contador de apartados. -->
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Titulo}" FontSize="17" FontWeight="Bold" Foreground="#111827"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Titulo}"/>
                    <TextBlock Text="{Binding Ubicacion}" Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Ubicacion}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Contador}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="#374151" HorizontalAlignment="Right"/>
                        <TextBlock Text="completados" Foreground="#9CA3AF" FontSize="11"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                    <Button Content="Guardar" Command="{Binding Guardar}" Padding="18,7"
                            Background="#2563EB" Foreground="White" BorderThickness="0"
                            Cursor="Hand" VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <!-- Planificación, entre guardar y exportar. Con el verde de la gestión
                         de proyectos, porque eso es lo que enseña: no es un apartado del
                         ensayo y no debe parecerlo. -->
                    <Button Content="Planificación" Command="{Binding VerPlanificacion}" Padding="18,7"
                            Background="#0F766E" Foreground="White" BorderThickness="0"
                            Cursor="Hand" VerticalAlignment="Center" Margin="0,0,8,0"
                            ToolTip="Fechas, estado, muestras e importe de esta TdN"/>

                    <!-- Discreto a propósito, ver el estilo. Al lado de «Guardar» y
                         «Planificación», que llevan color, se distingue igual: es el
                         único de los tres sin fondo. -->
                    <Button Content="Exportar" Command="{Binding ExportarInforme}" Padding="18,7"
                            Style="{StaticResource BotonDiscreto}"
                            Cursor="Hand" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Auto, no 360: así la columna desaparece al plegar el índice -->
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Índice en árbol: secciones colapsadas, apartados dentro.
                 El ancho lo decide la ventana (AnchoDelIndice): con 360 fijos, en la
                 ventana mínima se comía más de la mitad y el formulario se salía por la
                 derecha. La columna sigue siendo Auto para que al plegarlo no reserve
                 nada — una columna proporcional dejaría el hueco vacío. -->
            <Border Background="White" BorderBrush="#E1E4E8" BorderThickness="0,0,1,0"
                    Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window},
                            Converter={StaticResource AnchoIndice}}"
                    Visibility="{Binding IndiceVisible, Converter={StaticResource BoolAVisible}}">
                <TreeView ItemsSource="{Binding Arbol}"
                          SelectedItemChanged="AlSeleccionarNodo"
                          BorderThickness="0" Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0,2"/>
                            <!-- Oculta las secciones que se quedan sin apartados aplicables -->
                            <Setter Property="Visibility"
                                    Value="{Binding Visible, Converter={StaticResource BoolAVisible}}"/>
                            <!--
                                Lo señalado lo manda el nodo, en los dos sentidos.
                                `TreeView.SelectedItem` es de solo lectura: sin esta atadura no
                                hay forma de quitarle la marca al árbol cuando se sale por el
                                botón «Planificación», y el nodo se quedaba señalado sin ser el
                                panel abierto — con lo que volver a pulsarlo no avisaba de nada.
                            -->
                            <Setter Property="IsSelected" Value="{Binding Seleccionado, Mode=TwoWay}"/>
                            <!--
                                Cómo se anuncia el nodo. Va en el contenedor y no dentro de la
                                plantilla porque **el elemento que ve la automatización es el
                                `TreeViewItem`**, no la rejilla que lleva dentro. Puesto en la
                                plantilla no sirve de nada: se probó, y los 31 nodos seguían
                                diciendo «LumNotas.App.ViewModels.SeccionViewModel».
                            -->
                            <Setter Property="AutomationProperties.Name" Value="{Binding Rotulo}"/>
                            <Style.Triggers>
                                <!-- El documento marca la sección del apartado abierto -->
                                <DataTrigger Binding="{Binding Expandida}" Value="True">
                                    <Setter Property="IsExpanded" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TreeView.ItemContainerStyle>

                    <TreeView.Resources>
                        <!--
                            Realce de la fila seleccionada. El azul del sistema con texto blanco
                            chocaba con la paleta del resto de la ventana y tapaba el punto de
                            color de la fila. Cambiando estas cuatro brochas del tema se queda en
                            un realce suave con el texto oscuro, y no hay que rehacer la plantilla
                            de TreeViewItem —que trae el triángulo de desplegar y la sangría, y
                            copiarla entera para cambiar un color sale caro—.
                            La pareja «Inactive» es la que de verdad se ve casi siempre: en cuanto
                            se escribe en el formulario, el foco deja de estar en el árbol.
                        -->
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#DDE5F0"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#111827"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                                         Color="#E9EEF5"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                                         Color="#111827"/>

                        <!--
                            MaxWidth explícito en cada plantilla: la plantilla por defecto de
                            TreeViewItem coloca la cabecera en una columna de ancho Auto, así que
                            sin un límite el texto crece y se sale del panel en vez de partirse.
                            Los valores descuentan la sangría del nivel (19 px), el punto y los
                            márgenes sobre los 360 px de la columna.
                        -->

                        <!-- Sección: cabecera desplegable con la cuenta de sus apartados -->
                        <HierarchicalDataTemplate DataType="{x:Type vm:SeccionViewModel}"
                                                  ItemsSource="{Binding Apartados}">
                            <!-- El margen de arriba es el aire que separa una sección de la
                                 anterior; una raya no vale, porque la cabecera solo ocupa lo que
                                 mide su texto y saldrían rayas de largos distintos. -->
                            <Grid Margin="2,10,2,4" MaxWidth="315" ToolTip="{Binding Resumen}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- La píldora sustituye al punto de color: dice lo mismo y además
                                     cuánto queda. El MinWidth alinea los títulos entre secciones,
                                     que si no bailan según la cuenta ocupe tres o cinco letras. -->
                                <Border MinWidth="38" Padding="6,1,6,2" CornerRadius="8"
                                        Margin="0,1,8,0" VerticalAlignment="Top"
                                        Background="{Binding Estado, Converter={StaticResource EstadoAColor},
                                                             ConverterParameter=Fondo}">
                                    <TextBlock Text="{Binding Progreso}" FontSize="10"
                                               HorizontalAlignment="Center"
                                               Foreground="{Binding Estado, Converter={StaticResource EstadoAColor},
                                                                    ConverterParameter=Texto}"/>
                                </Border>

                                <TextBlock Grid.Column="1" Text="{Binding Titulo}" TextWrapping="Wrap"
                                           FontWeight="Bold" Foreground="#111827" VerticalAlignment="Top"/>
                            </Grid>
                        </HierarchicalDataTemplate>

                        <!-- Apartado dentro de una sección -->
                        <DataTemplate DataType="{x:Type vm:BloqueViewModel}">
                            <Grid Margin="2,3" MaxWidth="290">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="8" Height="8" Margin="0,5,8,0" VerticalAlignment="Top"
                                         Fill="{Binding Estado, Converter={StaticResource EstadoAColor}}"/>
                                <StackPanel Grid.Column="1">
                                    <!-- Un apartado marcado N/A se apaga: sigue estando, para que
                                         se vea que se decidió, pero deja de competir por la vista
                                         con los que hay que rellenar. -->
                                    <TextBlock Text="{Binding Encabezado}" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NoAplica}" Value="True">
                                                        <Setter Property="Foreground" Value="#9CA3AF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Solo dice «No aplica»; el resto de estados los da el punto.
                                         Vacío se pliega, para no dejar un renglón en blanco que
                                         separaría las filas sin decir nada. -->
                                    <TextBlock Text="{Binding EstadoTexto}" FontSize="10"
                                               TextWrapping="Wrap" Foreground="#9CA3AF">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EstadoTexto}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>

                        <!-- Cabecera del proyecto: nodo suelto en la raíz -->
                        <DataTemplate DataType="{x:Type vm:ProyectoViewModel}">
                            <TextBlock Text="{Binding Encabezado}" FontWeight="Bold" Margin="20,6,2,6"
                                       MaxWidth="300" TextWrapping="Wrap" Foreground="#111827"/>
                        </DataTemplate>

                        <!-- La planificación ya no cuelga del árbol: se llega por su botón de
                             la barra de arriba. Aquí no queda plantilla porque aquí no hay
                             nodo. -->

                    </TreeView.Resources>
                </TreeView>
            </Border>

            <!--
                Panel seleccionado: cabecera del proyecto o apartado de ensayo.
                Scroll horizontal para llegar a las 8 columnas de muestra.
            -->
            <ScrollViewer Grid.Column="1" Padding="24,20"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <!--
                    El manejador va AQUÍ DENTRO, no en el ScrollViewer: quien desplaza de
                    verdad es el ScrollContentPresenter de su plantilla, que está por
                    debajo. Marcando el evento en el ScrollViewer se llega tarde y la vista
                    ya se ha movido de lado.
                -->
                <ContentControl Content="{Binding PanelActual}"
                                RequestBringIntoView="AlPedirLlevarALaVista"/>
            </ScrollViewer>
        </Grid>
                        </Grid>

        <!--
            Portada. Se dibuja encima de las pestañas y las tapa hasta que el técnico
            elige norma, abre un proyecto o se va al tablero de gestión.
        -->
        <Border Background="#F5F6F8"
                Visibility="{Binding SinProyecto, Converter={StaticResource BoolAVisible}}">
            <ScrollViewer x:Name="LienzoInicio" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <!--
                    El Grid toma la altura del visor, así que la portada queda centrada
                    mientras quepa y pasa a desplazarse cuando no cabe.
                -->
                <Grid MinHeight="{Binding ViewportHeight, ElementName=LienzoInicio}">
                <!--
                    Stretch, no Center: con Center el panel se encoge al contenido y las
                    tarjetas nunca aprovechan el ancho. Con Stretch ocupa lo que haya
                    hasta MaxWidth, y a partir de ahí WPF lo centra solo.
                -->
                <StackPanel MaxWidth="940" Margin="24,32"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <!--
                        El nombre del programa, no el de una de sus dos mitades. La versión va
                        al lado para poder leerla sin abrir ningún menú: es lo primero que hay
                        que preguntar cuando alguien avisa de un fallo.
                    -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static vm:VentanaPrincipalViewModel.NombreDelPrograma}"
                                   FontSize="{StaticResource TamTitulo}" FontWeight="Bold"
                                   Foreground="{StaticResource TintaFuerte}"/>
                        <Border CornerRadius="9" Background="#E8EAEE" Padding="8,4"
                                Margin="8,0,0,0" VerticalAlignment="Center">
                            <!-- Tinta más oscura que el gris de siempre: sobre este gris,
                                 #6B7280 daba 4,06:1 y suspendía AA. Ahora 6,20:1 -->
                            <TextBlock Text="{x:Static vm:VentanaPrincipalViewModel.VersionEnEjecucion}"
                                       FontSize="{StaticResource TamApoyo}"
                                       Foreground="{StaticResource TintaSobreGris}"/>
                        </Border>
                    </StackPanel>
                    <!-- Sin citar la norma: el programa lleva cuatro y las que se dejen
                         caer en la carpeta, así que nombrar una sola sobraba -->
                    <TextBlock Text="Software de toma de notas primarias para ensayos y planificación de servicios"
                               Foreground="{StaticResource TintaSuave}" FontSize="{StaticResource TamApoyo}"
                               Margin="0,8,0,24" TextWrapping="Wrap"/>

                    <!--
                        Avisos. No existe si no hay nada que hacer: un recuadro que casi
                        siempre está deja de leerse, y entonces no sirve el día que importa.
                    -->
                    <ItemsControl ItemsSource="{Binding DataContext.Avisos, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Margin="0,0,0,22"
                                  Visibility="{Binding DataContext.HayAvisos, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolAVisible}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" BorderThickness="1" Padding="16,13" Margin="0,0,0,8"
                                        Background="{Binding Fondo}" BorderBrush="{Binding Borde}">
                                    <DockPanel>
                                        <!-- El botón que lo arregla, al lado de lo que hay que arreglar -->
                                        <Button DockPanel.Dock="Right" Content="{Binding Boton}"
                                                Command="{Binding Resolver}"
                                                Padding="12,6" Margin="14,0,0,0" Cursor="Hand"
                                                VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Texto}" TextWrapping="Wrap"
                                                       FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{Binding Color}"/>
                                            <TextBlock Text="{Binding Detalle}" TextWrapping="Wrap"
                                                       FontSize="11" Margin="0,3,0,0"
                                                       Foreground="{Binding Color}" Opacity="0.85"
                                                       Visibility="{Binding HayDetalle, Converter={StaticResource BoolAVisible}}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--
                        Izquierda, tomar notas; derecha, gestionar. Son dos oficios distintos y
                        pesan lo mismo, así que la portada se parte por la mitad: dos columnas
                        iguales, sin ancho fijo. Con «*» y «*» nadie puede pedir más de lo que
                        hay, que es lo que provocaba el recorte silencioso de WPF; en la ventana
                        más pequeña que se admite (740) siguen cabiendo las dos tarjetas de norma.
                    -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!--
                                La izquierda algo más ancha: es la que tiene que caber tres
                                tarjetas de norma por fila. La derecha lleva tres botones y
                                se apaña con menos, que además es lo que hace que su texto
                                pase a dos líneas en vez de recortarse.
                            -->
                            <ColumnDefinition Width="1.35*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!--
                            ZONA 1 · la toma de notas, en azul.
                            No hay «proyecto» que crear: el registro del ensayo es el
                            .lmnlab y vive en la carpeta de tomas de notas de su servicio.
                            Un fichero de proyecto aparte sería un documento sin ensayo
                            detrás, y eso rompe la trazabilidad (DD‑89).
                        -->
                        <Border Grid.Column="0" Style="{StaticResource ZonaInicio}">
                            <StackPanel>
                                <!-- El margen de abajo era del renglón de apoyo que había
                                     debajo; al quitarlo pasa aquí, o los botones subirían a
                                     pegarse al rótulo de la zona. -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <Border Width="4" Height="16" CornerRadius="2" Background="#2563EB"
                                            Margin="0,0,8,0"/>
                                    <TextBlock Text="TOMA DE NOTAS" Style="{StaticResource RotuloZona}"
                                               Foreground="#2563EB"/>
                                </StackPanel>

                                <!--
                                    LA PRIMARIA DE ESTA ZONA, y la única con relleno de color
                                    aquí dentro. Ancho completo y 48 de alto: es lo más pulsado
                                    del lado izquierdo, así que es lo más grande y lo primero
                                    donde cae el ojo al entrar en la zona.

                                    Antes medía 150×40 y compartía peso con las cinco filas de
                                    norma, que llevaban caja y borde propios. Con seis cosas
                                    del mismo peso no había primera.
                                -->
                                <!-- Ajustada al texto y no a todo el ancho: un botón de 780 px
                                     para tres palabras no se lee como un botón, se lee como
                                     una banda. El relleno del estilo (16,12) le da el aire. -->
                                <Button Style="{StaticResource AccionPrimaria}"
                                        Background="{StaticResource AzulNotas}"
                                        HorizontalAlignment="Left"
                                        Command="{Binding DataContext.Abrir, RelativeSource={RelativeSource AncestorType=Window}}"
                                        AutomationProperties.Name="Abrir TdN existente"
                                        ToolTip="Abrir una toma de notas que ya existe (Ctrl+O)">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconoCarpeta}" Stroke="White"
                                              StrokeThickness="1.3" StrokeLineJoin="Round"
                                              VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock Text="Abrir TdN existente" FontSize="{StaticResource TamAccion}"
                                                   FontWeight="Bold" Foreground="White"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <StackPanel Margin="0,16,0,0"
                                            Visibility="{Binding DataContext.HayRecientes, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolAVisible}}">
                                        <TextBlock Text="RECIENTES"
                                                   Style="{StaticResource RotuloZona}"
                                                   Foreground="{StaticResource TintaSuave}"
                                                   Margin="0,0,0,8"/>

                                        <!--
                                            DOS COLUMNAS. Un nombre de toma de notas ocupa
                                            unos 24 caracteres; a lo ancho de la zona cabían
                                            tres veces. Cinco rectángulos de 780 px para eso
                                            era tirar el ancho y gastar el alto, que es lo
                                            que escasea.
                                        -->
                                        <ItemsControl ItemsSource="{Binding DataContext.UltimosAbiertos, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!--
                                                SECUNDARIA: contorno. Volver a lo de ayer es lo
                                                más frecuente después de abrir, pero no puede
                                                llevar relleno de color o habría dos primeras.

                                                Solo el nombre, en una línea; la carpeta vive en
                                                el consejo emergente. Rejilla y no StackPanel:
                                                dentro de un StackPanel el ancho es infinito y el
                                                nombre no sabría dónde recortarse (sexta trampa).
                                            -->
                                            <!-- Del alto y la letra de las filas de norma: una
                                                 sola línea de texto no necesitaba 44 px de
                                                 caja. Sigue muy por encima del objetivo táctil
                                                 que pide AA (24), aunque por debajo del 44 de
                                                 la regla que traíamos. -->
                                            <Button Style="{StaticResource AccionSecundaria}"
                                                    Margin="0,0,8,6" MinHeight="34" Padding="12,6"
                                                    ToolTip="{Binding Ruta}"
                                                    Command="{Binding DataContext.AbrirReciente,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Ruta}"
                                                    AutomationProperties.Name="{Binding Nombre}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Nombre}"
                                                               FontSize="{StaticResource TamApoyo}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TintaFuerte}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                </StackPanel>

                                <Border Height="1" Background="#EEF0F3" Margin="0,24,0,16"/>

                                <TextBlock Text="O crea una nueva con la norma que necesites"
                                           TextWrapping="Wrap" FontSize="{StaticResource TamApoyo}"
                                           Foreground="{StaticResource TintaSuave}"
                                           Margin="0,0,0,8"/>

                                <!--
                                    Una fila por norma instalada. Sale de CatalogoDeNormas,
                                    así que dejar caer un plantilla-*.json añade la suya sin
                                    tocar nada — incluido el orden, que lo da el título.
                                -->
                                <ItemsControl ItemsSource="{Binding Normas}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!--
                                                TERCIARIA: sin caja hasta que se pasa por encima.
                                                Estrenar norma es lo menos frecuente de la zona y
                                                llevaba caja y borde propios, igual que las
                                                recientes. Sigue midiendo 44 de alto: rebajar el
                                                peso visual no es rebajar el objetivo táctil.

                                                Rejilla y no StackPanel: dentro de un StackPanel
                                                el ancho es infinito y la designación no sabría
                                                dónde recortarse.
                                            -->
                                            <Button Style="{StaticResource AccionTerciaria}"
                                                    Margin="0,0,8,4"
                                                    Command="{Binding DataContext.EmpezarConNorma,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding Titulo}"
                                                    ToolTip="{Binding Titulo}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <!-- La designación entera, con sus
                                                             enmiendas: es lo que distingue dos
                                                             años de la misma norma -->
                                                        <TextBlock Text="{Binding Designacion}"
                                                                   FontSize="{StaticResource TamApoyo}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TintaFuerte}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding DescripcionConEdicion}"
                                                                   FontSize="{StaticResource TamApoyo}"
                                                                   Foreground="{StaticResource TintaSuave}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!--
                            ZONA 2 · gestión, en verde azulado para que no se confunda.
                            Cada vista tiene su enlace directo: entrar a la de gestión y luego
                            buscar el botón de la vista eran dos pasos para lo mismo.
                        -->
                        <Border Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top"
                                Style="{StaticResource ZonaInicio}">
                            <StackPanel>
                                <!-- Igual que la zona de al lado: el margen del renglón de
                                     apoyo que se quitó se hereda aquí, para que las dos
                                     columnas sigan empezando a la misma altura. -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <Border Width="4" Height="16" CornerRadius="2" Background="#0F766E"
                                            Margin="0,0,8,0"/>
                                    <TextBlock Text="GESTIÓN DE SERVICIOS" Style="{StaticResource RotuloZona}"
                                               Foreground="#0F766E"/>
                                </StackPanel>

                                <!--
                                    Dar de alta encabeza la zona (2026‑08‑06). Antes no
                                    estaba aquí —se decía que esta zona es para mirar, no
                                    para crear—, pero quien planifica entra por aquí, y
                                    obligarle a buscarlo en el menú «Archivo» era mandarle a
                                    la zona del que toma notas para hacer algo que es suyo.
                                    Abre la misma ventana que ese menú.
                                -->
                                <!-- Ajustada al texto, como la azul. Y con aire por debajo: pegada
                                     a la rejilla de vistas parecía la primera de las cinco en vez
                                     de la acción que encabeza la zona. -->
                                <Button Style="{StaticResource AccionPrimaria}"
                                        Background="{StaticResource VerdeGestion}"
                                        HorizontalAlignment="Left" Margin="0,0,0,20"
                                        Command="{Binding DataContext.NuevoProyecto, RelativeSource={RelativeSource AncestorType=Window}}"
                                        AutomationProperties.Name="Planificar nueva toma de notas"
                                        ToolTip="Da de alta la toma de notas para poder planificarla: con el código, el técnico y la norma ya se puede">
                                    <!-- Sin subtexto: lo que explicaba está en el consejo
                                         emergente. Este botón y el azul de la izquierda son
                                         los dos que más se pulsan y no necesitan que se les
                                         explique nada cada vez. -->
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconoNuevo}" Stroke="White"
                                              StrokeThickness="1.6" StrokeLineJoin="Round"
                                              VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock Text="Planificar nueva TdN" FontSize="{StaticResource TamAccion}"
                                                   FontWeight="Bold" Foreground="White"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!--
                                    LAS CUATRO VISTAS, EN REJILLA 2×2 Y CON ICONO. Eran
                                    cuatro filas apiladas a todo lo ancho para escribir una
                                    palabra: gastaban el alto de la zona y dejaban muerto el
                                    ancho. En dos por dos ocupan la mitad de alto.

                                    El icono no es adorno: «Tablero», «Calendario», «Carga»
                                    y «BBDD» son cuatro palabras abstractas que hay que leer
                                    una a una. Con un dibujo se distinguen antes de leerlas,
                                    y a los tres días se pulsa por la forma.
                                -->
                                <UniformGrid Columns="2">
                                    <Button Style="{StaticResource AccionSecundaria}" Margin="0,0,8,8"
                                            Command="{Binding DataContext.IrAVistaDeGestion, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{x:Static vm:Vista.Tablero}"
                                            AutomationProperties.Name="Tablero"
                                            ToolTip="Qué falta por rellenar, TdN a TdN">
                                        <StackPanel>
                                            <Path Data="{StaticResource IconoTablero}"
                                                  Stroke="{StaticResource VerdeGestion}" StrokeThickness="1.3"
                                                  StrokeLineJoin="Round" HorizontalAlignment="Left"
                                                  Margin="0,0,0,8"/>
                                            <TextBlock Text="Tablero" FontSize="{StaticResource TamAccion}" FontWeight="Bold"
                                                       Foreground="{StaticResource TintaFuerte}"/>
                                            <TextBlock Text="Qué falta por rellenar"
                                                       TextWrapping="Wrap" FontSize="{StaticResource TamApoyo}"
                                                       Foreground="{StaticResource TintaSuave}"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource AccionSecundaria}" Margin="0,0,0,8"
                                            Command="{Binding DataContext.IrAVistaDeGestion, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{x:Static vm:Vista.Calendario}"
                                            AutomationProperties.Name="Calendario"
                                            ToolTip="Línea temporal de planificación">
                                        <StackPanel>
                                            <Path Data="{StaticResource IconoCalendario}"
                                                  Stroke="{StaticResource VerdeGestion}" StrokeThickness="1.3"
                                                  StrokeLineJoin="Round" HorizontalAlignment="Left"
                                                  Margin="0,0,0,8"/>
                                            <TextBlock Text="Calendario" FontSize="{StaticResource TamAccion}" FontWeight="Bold"
                                                       Foreground="{StaticResource TintaFuerte}"/>
                                            <TextBlock Text="Línea temporal"
                                                       TextWrapping="Wrap" FontSize="{StaticResource TamApoyo}"
                                                       Foreground="{StaticResource TintaSuave}"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource AccionSecundaria}" Margin="0,0,8,0"
                                            Command="{Binding DataContext.IrAVistaDeGestion, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{x:Static vm:Vista.Carga}"
                                            AutomationProperties.Name="Carga"
                                            ToolTip="Carga de trabajo por técnico y mes">
                                        <StackPanel>
                                            <Path Data="{StaticResource IconoCarga}"
                                                  Stroke="{StaticResource VerdeGestion}" StrokeThickness="1.3"
                                                  StrokeLineJoin="Round" HorizontalAlignment="Left"
                                                  Margin="0,0,0,8"/>
                                            <TextBlock Text="Carga" FontSize="{StaticResource TamAccion}" FontWeight="Bold"
                                                       Foreground="{StaticResource TintaFuerte}"/>
                                            <TextBlock Text="Por técnico y mes"
                                                       TextWrapping="Wrap" FontSize="{StaticResource TamApoyo}"
                                                       Foreground="{StaticResource TintaSuave}"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- La cuarta mira hacia atrás y no hacia lo que queda por
                                         hacer: por eso la lupa y no otra cosa. -->
                                    <Button Style="{StaticResource AccionSecundaria}" Margin="0"
                                            Command="{Binding DataContext.IrAVistaDeGestion, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{x:Static vm:Vista.Bbdd}"
                                            AutomationProperties.Name="BBDD"
                                            ToolTip="Buscar cualquier toma de notas, también las terminadas">
                                        <StackPanel>
                                            <Path Data="{StaticResource IconoBuscar}"
                                                  Stroke="{StaticResource VerdeGestion}" StrokeThickness="1.3"
                                                  StrokeLineJoin="Round" HorizontalAlignment="Left"
                                                  Margin="0,0,0,8"/>
                                            <TextBlock Text="BBDD" FontSize="{StaticResource TamAccion}" FontWeight="Bold"
                                                       Foreground="{StaticResource TintaFuerte}"/>
                                            <TextBlock Text="Buscar cualquier TdN"
                                                       TextWrapping="Wrap" FontSize="{StaticResource TamApoyo}"
                                                       Foreground="{StaticResource TintaSuave}"/>
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>

                            </StackPanel>
                        </Border>
                    </Grid>

                </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
                      </Grid>
                    </DataTemplate>

        <!-- Gestión de proyectos: dos vistas de la misma carpeta.
             · Tablero    → qué falta por rellenar
             · Calendario → cuándo toca cada servicio -->
        <DataTemplate DataType="{x:Type vm:GestionViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="White" BorderBrush="#E1E4E8" BorderThickness="0,0,0,1" Padding="20,12">
                    <StackPanel>
                        <!--
                            WrapPanel y no StackPanel horizontal: un StackPanel no envuelve
                            nunca, así que al estrechar la ventana lo que no cabía se
                            recortaba en silencio —se perdían «Actualizar» y los tres
                            filtros, que son lo que hace útil la vista—. Envolviendo, la
                            barra pasa a dos o tres filas y no se pierde ningún mando.
                        -->
                        <WrapPanel Margin="0,0,0,4">
                            <Button Content="Tablero" Command="{Binding VerTablero}" Margin="0,0,6,6"
                                    Style="{StaticResource Vista}"
                                    Tag="{Binding VistaTablero}"/>
                            <Button Content="Calendario" Command="{Binding VerCalendario}" Margin="0,0,6,6"
                                    Style="{StaticResource Vista}"
                                    Tag="{Binding VistaCalendario}"/>
                            <Button Content="Carga" Command="{Binding VerCarga}" Margin="0,0,6,6"
                                    Style="{StaticResource Vista}"
                                    Tag="{Binding VistaCarga}"
                                    ToolTip="Cuánto tiene comprometido cada técnico cada mes"/>
                            <Button Content="BBDD" Command="{Binding VerBbdd}" Margin="0,0,18,6"
                                    Style="{StaticResource Vista}"
                                    Tag="{Binding VistaBbdd}"
                                    ToolTip="Todas las tomas de notas, con buscador. Enseña también las terminadas y las archivadas"/>

                            <!-- Dar de alta es lo que más se pulsa: se queda con su color,
                                 y en «+» porque el rótulo entero ocupaba media barra. El
                                 consejo emergente dice lo que decía el rótulo. -->
                            <Button Content="+" Style="{StaticResource BotonIcono}"
                                    Command="{Binding DataContext.NuevoProyecto, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Width="34" Height="30" FontSize="18" FontWeight="Bold"
                                    Cursor="Hand" Margin="0,0,8,6"
                                    Background="#0F766E" Foreground="White" BorderThickness="0"
                                    ToolTip="Nueva toma de notas — solo hacen falta el código, el técnico y la norma"/>

                            <Button Content="Elegir carpeta" Command="{Binding ElegirCarpeta}"
                                    Padding="14,6" Cursor="Hand" Margin="0,0,8,6"/>
                            <Button Content="Actualizar" Command="{Binding Refrescar}"
                                    Padding="14,6" Cursor="Hand" Margin="0,0,8,6"/>

                            <!--
                                Buscar y filtrar, juntos y en el mismo bloque para que al
                                estrechar la ventana caigan a la vez a la fila siguiente:
                                son la misma pregunta —qué estoy mirando— partida en dos.

                                Valen para las cuatro vistas, BBDD incluida. Antes el botón
                                aparecía allí sin hacer nada y el listado tenía sus propios
                                mandos: dos juegos de filtros para los mismos proyectos,
                                que es la manera más fácil de que discrepen.
                            -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Buscar" VerticalAlignment="Center" FontSize="11"
                                           Foreground="#6B7280" Margin="0,0,6,6"/>
                                <!-- Se filtra al teclear: lo leído ya está en memoria y
                                     filtrarlo es instantáneo. -->
                                <TextBox Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}"
                                         MinWidth="180" VerticalAlignment="Center" Padding="6,4"
                                         Margin="0,0,8,6"
                                         ToolTip="Busca en el código, los técnicos, la norma, la acreditación y los colaboradores. Se suma a los filtros"/>

                                <!--
                                    Los tres filtros, dentro. El rótulo lleva la cuenta de los
                                    que están apartando algo y el consejo emergente dice qué se
                                    está viendo: escondidos y mudos, alguien no encontraría su
                                    servicio y creería que se ha perdido.
                                -->
                                <Button Content="{Binding RotuloFiltros}" Click="AlAbrirFiltros"
                                        ToolTip="{Binding DetalleFiltros}"
                                        Padding="14,6" Cursor="Hand" Margin="0,0,0,6">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HayFiltros}" Value="True">
                                                    <Setter Property="Background" Value="#CCFBF1"/>
                                                    <Setter Property="BorderBrush" Value="#0F766E"/>
                                                    <Setter Property="Foreground" Value="#115E59"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>

                            <!--
                                Exportar el listado. Solo se puede en la BBDD (DD‑140), así
                                que aparece y desaparece — y por eso va **el último de la
                                barra**: delante de él no hay nada que se mueva de sitio al
                                entrar y salir.

                                Vivió una fila más abajo, en una franja propia junto a «47
                                tomas de notas». La franja se quitó: repetía la cuenta que ya
                                da la línea de estado y gastaba un renglón entero de tabla
                                para un solo botón.

                                Discreto a propósito —sin fondo y en negrita, ver el
                                estilo—, el mismo que «Exportar» en la toma de notas: es
                                la misma acción y no puede cambiar de aspecto según la
                                pestaña.
                            -->
                            <Button Content="Exportar" Command="{Binding Bbdd.Exportar}"
                                    Style="{StaticResource BotonDiscreto}"
                                    Padding="18,6" Cursor="Hand" Margin="18,0,0,6"
                                    Visibility="{Binding VistaBbdd, Converter={StaticResource BoolAVisible}}"
                                    ToolTip="Guardar en HTML todas las tomas de notas del listado, para imprimir en A4 apaisado"/>
                        </WrapPanel>

                        <!-- Ajustes propios de la línea de tiempo. Los filtros están arriba,
                             porque valen para las tres vistas. Envuelve por lo mismo. -->
                        <WrapPanel Visibility="{Binding VistaCalendario, Converter={StaticResource BoolAVisible}}">
                            <CheckBox Content="Agrupar por técnico"
                                      IsChecked="{Binding Calendario.AgruparPorTecnico}"
                                      VerticalAlignment="Center" Margin="0,0,14,0"/>

                            <Button Content="−" Command="{Binding Calendario.Alejar}" Width="26"
                                    Padding="0,3" Cursor="Hand" ToolTip="Semanas más estrechas"/>
                            <Button Content="+" Command="{Binding Calendario.Acercar}" Width="26"
                                    Padding="0,3" Cursor="Hand" Margin="4,0,14,0"
                                    ToolTip="Semanas más anchas"/>

                            <!-- Aquí iban «◀ Hoy ▶» y el rótulo del periodo. Se fueron: por
                                 la línea de tiempo se camina con la barra de desplazamiento,
                                 que ahora está siempre a la vista, y los meses ya están
                                 escritos en la propia cabecera del calendario. Los comandos
                                 siguen existiendo en el modelo, sin botón que los llame. -->
                        </WrapPanel>

                        <!-- La ruta de la carpeta ya no se enseña: ocupaba una línea entera
                             en las cuatro vistas para repetir algo que no cambia en todo el
                             día. Sigue estando en «Configuración | Carpetas». -->
                        <TextBlock Text="{Binding Mensaje}" Foreground="#6B7280" FontSize="12" Margin="0,6,0,0"/>

                        <!--
                            Lo que ha hecho el programa por su cuenta en ficheros que nadie
                            había abierto: recolocar las familias de un trabajo. Va aparte
                            del mensaje del escaneo, que lo borraría al terminar de leer.
                        -->
                        <TextBlock Text="{Binding Aviso}" Foreground="#B45309" FontSize="12"
                                   FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HayAviso, Converter={StaticResource BoolAVisible}}"/>

                        <!-- Con una carpeta de clientes grande el escaneo tarda; que se vea
                             que está trabajando y no colgado -->
                        <ProgressBar Height="3" IsIndeterminate="True" Margin="0,6,0,0"
                                     Background="Transparent" BorderThickness="0" Foreground="#2563EB"
                                     Visibility="{Binding Explorando, Converter={StaticResource BoolAVisible}}"/>
                    </StackPanel>
                </Border>

                <!--
                    ===================== TABLERO =====================

                    Virtualizado (2026‑08‑06). Es la vista que más cuesta con diferencia:
                    una columna por proyecto, y cada columna con una tarjeta por sección
                    pendiente. Con 250 proyectos, crearlas todas tardaba **1,7 s cada vez
                    que cambiaba un filtro** — y se pagaban igual mirando otra vista,
                    porque plegar una vista no destruye lo que ya se creó.

                    Ahora solo existen las columnas que se ven. La lista es la dueña de su
                    propio desplazamiento —de ahí la plantilla—: dentro de un ScrollViewer
                    de fuera se mediría con ancho infinito y no virtualizaría nada.
                -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Proyectos}"
                              Visibility="{Binding VistaTablero, Converter={StaticResource BoolAVisible}}"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              ScrollViewer.CanContentScroll="True">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer CanContentScroll="True" Padding="16,14"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Una columna por proyecto -->
                                <Border Width="290" Margin="0,0,14,0" Background="#EEF0F3"
                                        CornerRadius="8" Padding="12" VerticalAlignment="Top">
                                    <StackPanel>
                                        <!--
                                            Servicio y familia, sin la edición del documento, con los
                                            mismos dos avisos que lleva la barra del calendario. Aquí
                                            hacen más falta todavía: el tablero es donde se decide qué
                                            se coge hoy, y eso depende de si la muestra está en el
                                            laboratorio tanto como de lo que quede por rellenar.

                                            Rejilla y no StackPanel: dentro de un StackPanel horizontal
                                            el ancho es infinito y el rótulo dejaría de envolver. Es la
                                            misma trampa que en las barras del calendario.
                                        -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top"
                                                        Margin="0,4,0,0">
                                                <!--
                                                    Ámbar el que urge y gris el que solo informa: que las
                                                    muestras estén aquí mueve a hacer algo; que las fechas
                                                    estén blindadas solo avisa de que no se toquen.
                                                -->
                                                <Path Data="{StaticResource IconoCaja}"
                                                      Stroke="#B45309" StrokeThickness="1.2"
                                                      StrokeLineJoin="Round" Margin="0,0,6,0"
                                                      ToolTip="Las muestras ya están en el laboratorio"
                                                      Visibility="{Binding Planificacion.MuestrasRecibidas,
                                                                   Converter={StaticResource BoolAVisible}}"/>

                                                <Path Data="{StaticResource IconoCandado}"
                                                      Stroke="#6B7280" StrokeThickness="1.2"
                                                      StrokeLineJoin="Round" Margin="0,0,6,0"
                                                      ToolTip="Fechas bloqueadas"
                                                      Visibility="{Binding Planificacion.FechasBloqueadas,
                                                                   Converter={StaticResource BoolAVisible}}"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding Rotulo}" FontWeight="Bold"
                                                       FontSize="15" Foreground="#111827" TextWrapping="Wrap"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Tecnico}" Foreground="#6B7280" FontSize="11"/>
                                        <!--
                                            «3W | 45 % | 7/16 secciones». El renglón lo arma el
                                            resumen, no la vista, para que el calendario no se
                                            invente otra forma de escribir lo mismo. Lo que no
                                            hay se cae solo: sin fechas no hay semanas y sin
                                            pesos declarados no hay porcentaje.
                                        -->
                                        <TextBlock Text="{Binding LineaDeAvance}" Foreground="#374151" FontSize="12"
                                                   FontWeight="SemiBold" Margin="0,4,0,10"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <!-- Una tarjeta por sección pendiente -->
                                        <ItemsControl ItemsSource="{Binding SeccionesPendientes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="White" CornerRadius="5" Padding="10,8"
                                                            Margin="0,0,0,7" BorderBrush="#E1E4E8"
                                                            BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Titulo}" TextWrapping="Wrap"
                                                                       Foreground="#1F2937"/>
                                                            <TextBlock Foreground="#DC2626" FontSize="11"
                                                                       Margin="0,2,0,0">
                                                                <Run Text="{Binding Pendientes, Mode=OneWay}"/>
                                                                <Run Text="de"/>
                                                                <Run Text="{Binding Aplicables, Mode=OneWay}"/>
                                                                <Run Text="apartados pendientes"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ===================== CARGA =====================
                     Técnicos por meses, en porcentaje de ocupación. El tablero dice qué
                     falta, el calendario cuándo, y esto si cabe. -->
                <Grid Grid.Row="1"
                      Visibility="{Binding VistaCarga, Converter={StaticResource BoolAVisible}}">
                <Grid DataContext="{Binding Carga}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding Mensaje}" Foreground="#6B7280" FontSize="11"
                               Margin="20,12,20,0"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto" Padding="20,10,20,16">
                        <StackPanel>
                            <!-- Cabecera de meses -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Width="200"/>
                                <ItemsControl ItemsSource="{Binding Meses}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="74" Padding="0,4">
                                                <TextBlock Text="{Binding}" FontSize="10" FontWeight="Bold"
                                                           Foreground="#64748B" TextAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Filas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Border Width="200" Padding="0,0,10,0" VerticalAlignment="Center">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Tecnico}" FontWeight="SemiBold"
                                                               Foreground="#1E3A8A"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <!-- Sin importe no hay trabajo que repartir: se avisa
                                                         en vez de rebajar la carga en silencio -->
                                                    <TextBlock Text="{Binding SinImporte}" FontSize="10"
                                                               Foreground="#B45309"
                                                               Visibility="{Binding FaltaAlgunImporte,
                                                                            Converter={StaticResource BoolAVisible}}"/>
                                                </StackPanel>
                                            </Border>

                                            <ItemsControl ItemsSource="{Binding Meses}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="70" Height="34" Margin="2,0"
                                                                CornerRadius="6" Background="{Binding Fondo}"
                                                                ToolTip="{Binding Detalle}">
                                                            <TextBlock Text="{Binding Texto}"
                                                                       Foreground="{Binding Color}"
                                                                       FontWeight="{Binding Peso}"
                                                                       FontSize="12"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!--
                                La explicación va dentro del ScrollViewer horizontal de la
                                tabla, que ofrece ancho infinito: el texto se tendía hasta
                                sus 620 y obligaba a desplazarse en horizontal para leerlo,
                                aunque la tabla cupiera. Topándolo al ancho visible, envuelve
                                y el desplazamiento se queda para lo que sí lo necesita.
                            -->
                            <Border Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1"
                                    CornerRadius="8" Padding="14,10" Margin="0,16,0,0"
                                    HorizontalAlignment="Left"
                                    MaxWidth="{Binding ViewportWidth,
                                               RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                                <TextBlock FontSize="11" Foreground="#4B5563" TextWrapping="Wrap" MaxWidth="620"
                                           Text="El trabajo de cada TdN sale de su importe y se reparte entre los meses que abarca, en proporción a sus días.&#10;Para modificar el cálculo y los días de cada mes, ir a «Configuración» → «Capacidad y tarifa».&#10;&#10;Las tomas de notas con estado «Terminado» y «Archivados», por defecto no se computan como carga.&#10;Para ver la carga de trabajo de las tomas de notas «Archivados», usar los filtros.&#10;La carga de trabajo de las tomas de notas «Terminado» no se computa nunca, ni siquiera eligiendo el filtro."/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                </Grid>

                <!-- =================== BBDD ===================
                     El listado de todo, para encontrar un servicio de hace meses. Solo
                     lee: no es una base de datos aparte sino una lente sobre los mismos
                     .lmnlab que escanea el tablero. Y enseña también lo terminado y lo
                     archivado, porque es justo lo que se viene a buscar. -->
                <!--
                    Dos Grid y no uno: el de fuera decide si se ve y el de dentro cambia
                    el DataContext. Juntos en el mismo elemento, el DataContext se aplica
                    también a la atadura de Visibility —que pasaría a buscar «VistaBbdd»
                    dentro de BbddViewModel, donde no está—, la atadura falla en silencio
                    y la vista se queda visible encima de las otras tres.
                -->
                <Grid Grid.Row="1"
                      Visibility="{Binding VistaBbdd, Converter={StaticResource BoolAVisible}}">
                <Grid DataContext="{Binding Bbdd}">
                    <!--
                        Aquí había una segunda barra de filtros —buscar, IP, IK y
                        acreditación— propia del listado. Se fue al botón «Filtros», que
                        ahora manda en las cuatro vistas.

                        Y detrás quedó una franja con «47 tomas de notas» y el botón de
                        exportar, que también se ha ido: **la cuenta ya la da la línea de
                        estado** dos renglones más arriba —«47 proyectos | 186 fuera del
                        filtro»— y decirla otra vez, con otras palabras para lo mismo, solo
                        servía para hacer dudar de si hablaban de lo mismo. El botón subió a
                        la barra de mandos, que es donde están las otras acciones.
                    -->

                    <!--
                        Doce columnas no caben en una ventana estrecha, y aquí no se
                        encogen: se desplaza en horizontal, que en una tabla es lo que
                        se espera.

                        El desplazamiento se reparte: **el horizontal lo lleva este de
                        fuera** —así la cabecera de columnas viaja pegada a sus filas sin
                        sincronizar nada— y **el vertical lo lleva la lista de dentro**,
                        que es la única forma de que pueda virtualizar.

                        `VerticalScrollBarVisibility="Disabled"` no es decoración: es lo que
                        le da a la lista una altura finita. Con desplazamiento vertical aquí,
                        la lista se mediría con altura infinita, tendría que crear las 250
                        filas de golpe y no virtualizaría nada (la sexta trampa, en vertical).
                    -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled" Padding="20,12">
                        <Grid HorizontalAlignment="Left">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="No hay ninguna toma de notas que encaje con lo que buscas."
                                       Foreground="#6B7280" Margin="0,8,0,0"
                                       Visibility="{Binding NoHayNada, Converter={StaticResource BoolAVisible}}"/>

                            <!-- La cabecera de columnas, con los mismos anchos que las filas -->
                            <Border Grid.Row="1" BorderBrush="#D1D5DB" BorderThickness="0,0,0,2" Padding="0,0,0,6"
                                    Visibility="{Binding HayAlgo, Converter={StaticResource BoolAVisible}}">
                                <StackPanel Orientation="Horizontal" TextBlock.FontWeight="Bold"
                                            TextBlock.FontSize="11" TextBlock.Foreground="#6B7280">
                                    <TextBlock Text="CÓDIGO" Width="170"/>
                                    <TextBlock Text="ACREDITACIÓN" Width="130"/>
                                    <TextBlock Text="TÉCNICO 1" Width="150"/>
                                    <TextBlock Text="TÉCNICO 2" Width="150"/>
                                    <TextBlock Text="NORMA" Width="270"/>
                                    <TextBlock Text="MUESTRAS" Width="70"/>
                                    <TextBlock Text="IP" Width="70"/>
                                    <TextBlock Text="IK" Width="70"/>
                                    <TextBlock Text="ESTADO" Width="110"/>
                                    <TextBlock Text="ENSAYADO" Width="180"/>
                                    <TextBlock Text="LAB. EXTERNO" Width="200"/>
                                </StackPanel>
                            </Border>

                            <!--
                                Virtualizada: solo existen las filas que se ven. Con 250
                                tomas de notas, crearlas todas costaba 1,5 s cada vez que
                                cambiaba un filtro (medido el 2026‑08‑06).

                                Hacen falta las cuatro cosas a la vez: el panel
                                virtualizador, que la lista tenga **su propio** ScrollViewer
                                —de ahí la plantilla—, `CanContentScroll` para que cuente
                                elementos y no píxeles, y `ScrollUnit=Pixel` para que aun así
                                se desplace suave y no a saltos de fila.
                            -->
                            <ItemsControl Grid.Row="2" ItemsSource="{Binding Filas}"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          VirtualizingPanel.ScrollUnit="Pixel"
                                          ScrollViewer.CanContentScroll="True"
                                          Visibility="{Binding HayAlgo, Converter={StaticResource BoolAVisible}}">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer CanContentScroll="True"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#EEF0F3" BorderThickness="0,0,0,1" Padding="0,7">
                                            <StackPanel Orientation="Horizontal">
                                                <!-- Pulsar el código abre esa toma de notas en una pestaña -->
                                                <Button Content="{Binding Codigo}" Width="170"
                                                        HorizontalContentAlignment="Left" Padding="0"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="#2563EB" Cursor="Hand" FontWeight="SemiBold"
                                                        ToolTip="{Binding Ruta}"
                                                        Click="AlAbrirDeLaBbdd"/>
                                                <TextBlock Text="{Binding Acreditacion}" Width="130" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Tecnico1}" Width="150" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Tecnico2}" Width="150" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Norma}" Width="270" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Muestras}" Width="70"/>
                                                <TextBlock Text="{Binding Ip}" Width="70"/>
                                                <TextBlock Text="{Binding Ik}" Width="70"/>
                                                <TextBlock Text="{Binding Estado}" Width="110" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Ensayado}" Width="180" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Colaboradores}" Width="200" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>
                </Grid>

                <!-- =================== CALENDARIO =================== -->
                <Grid Grid.Row="1"
                      Visibility="{Binding VistaCalendario, Converter={StaticResource BoolAVisible}}">
                <Grid DataContext="{Binding Calendario}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cabecera: meses y semanas ISO, que es como planifica el laboratorio.
                         Se desplaza sola siguiendo el scroll horizontal de las barras. -->
                    <Grid Grid.Row="0" Background="#F8FAFC">
                        <Grid.ColumnDefinitions>
                            <!-- El mismo ancho que abajo, y por el mismo motivo: si la
                                 cabecera reserva un hueco que el cuerpo no gasta, las
                                 semanas dejan de caer sobre sus barras. -->
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Recortado: con la columna a cero, el rótulo se saldría por encima
                             de las semanas, porque un Border no recorta a su hijo. -->
                        <Border Grid.Column="0" Width="{Binding AnchoDeNombres}" ClipToBounds="True"
                                BorderBrush="#E5E7EB" BorderThickness="0,0,1,1" Padding="12,8">
                            <TextBlock Text="TÉCNICO" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"
                                       VerticalAlignment="Bottom"/>
                        </Border>

                        <!-- La cabecera va dentro de su propio ScrollViewer, atado al de las
                             barras. Con una transformación se quedaba en blanco al desplazarse
                             con la ventana pequeña: ver ScrollSincronizado. -->
                        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      local:ScrollSincronizado.Con="{Binding ElementName=Pista}">
                            <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                            <StackPanel HorizontalAlignment="Left">

                                <ItemsControl ItemsSource="{Binding Meses}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="{Binding Ancho}" BorderBrush="#E5E7EB"
                                                    BorderThickness="0,0,1,0" ClipToBounds="True">
                                                <TextBlock Text="{Binding Nombre}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="#475569" Margin="6,5,0,3"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding Semanas}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Celda" Width="{Binding Ancho}" BorderBrush="#E5E7EB"
                                                    BorderThickness="0,0,1,0" ClipToBounds="True" Padding="0,3,0,4">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Rotulo}" FontSize="10"
                                                               Foreground="#334155" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Desde}" FontSize="9"
                                                               Foreground="#94A3B8" HorizontalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <!-- La semana en curso se marca: es la que se mira siempre -->
                                                <DataTrigger Binding="{Binding EsActual}" Value="True">
                                                    <Setter TargetName="Celda" Property="Background" Value="#FEF2F2"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </Grid>

                    <!--
                        Cuerpo: nombres fijos a la izquierda, barras desplazables a la derecha.

                        Cada columna tiene su PROPIO desplazamiento vertical, atado al de la
                        otra. Antes había uno solo envolviendo las dos, y entonces la barra
                        horizontal quedaba al final del contenido: con veinte proyectos solo
                        asomaba al bajar del todo. Ahora la horizontal es la de «Pista», que
                        está pegada al borde de lo que se ve y no se va nunca.
                    -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <!-- El ancho lo pone el modelo de vista: sin agrupar por técnico
                                 esta columna no tiene nada que decir y se queda en cero. -->
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!--
                            Cabeceras de técnico. Recorre las mismas filas que las barras, con
                            las mismas alturas, y por eso van alineadas.

                            Los carriles pasan por aquí sin escribir nada: una fila ya no es un
                            trabajo, son todos los que caben en ella, así que no hay un nombre
                            que poner. El código de cada uno va dentro de su propia barra.

                            Debajo va un hueco del alto exacto de una barra horizontal, y
                            solo cuando las tarjetas tienen la suya. Sin él, esta columna
                            dispone de 17 px más de alto que la de tarjetas: las dos se
                            desplazan a la vez, pero esta llega al final antes, se queda
                            clavada y los nombres se separan de sus barras.

                            El hueco va aquí y no se le quita a las tarjetas porque la
                            columna de nombres NO puede llevar barra horizontal propia: en
                            cuanto un ScrollViewer permite desplazamiento horizontal mide su
                            contenido con ancho infinito, y entonces los nombres largos
                            dejan de recortarse con puntos.
                        -->
                        <Grid Grid.Column="0" Width="{Binding AnchoDeNombres}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0"
                                    Height="{x:Static SystemParameters.HorizontalScrollBarHeight}"
                                    Visibility="{Binding ComputedHorizontalScrollBarVisibility,
                                                 ElementName=Pista}"/>

                        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled"
                                      local:ScrollSincronizado.EnVerticalCon="{Binding ElementName=Pista}">
                            <ItemsControl ItemsSource="{Binding Filas}">
                                <ItemsControl.Resources>
                                    <!-- Cabecera de técnico: quién es, cuántos lleva y el
                                         triángulo de plegar. Todo en una línea. -->
                                    <DataTemplate DataType="{x:Type vm:GrupoDeTecnicoViewModel}">
                                        <Border Height="30" Background="#F1F5F9"
                                                BorderBrush="#E2E8F0" BorderThickness="0,0,1,1">
                                            <Button Command="{Binding Alternar}" Cursor="Hand"
                                                    Background="Transparent" BorderThickness="0"
                                                    Padding="8,0" HorizontalContentAlignment="Left"
                                                    ToolTip="Plegar o desplegar sus TdN">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Marca}" FontSize="10"
                                                               Foreground="#64748B" Margin="0,0,5,0"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Tecnico}" FontWeight="Bold"
                                                               Foreground="#1E3A8A" FontSize="12"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Proyectos}" FontSize="10"
                                                               Foreground="#64748B" Margin="6,0,0,0"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding AvisoDeRetraso}" FontSize="10"
                                                               Foreground="#DC2626" Margin="6,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding HayRetrasados,
                                                                            Converter={StaticResource BoolAVisible}}"/>
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                    </DataTemplate>

                                    <!-- Un carril del técnico. Va en blanco a propósito: lleva
                                         varios trabajos y cada uno se llama por su barra. Lo
                                         que hace aquí es reservar su alto —36, el mismo que
                                         al otro lado— para que las filas no se descuadren. -->
                                    <DataTemplate DataType="{x:Type vm:CarrilViewModel}">
                                        <Border Height="36" BorderBrush="#EEF0F3"
                                                BorderThickness="0,0,1,1"/>
                                    </DataTemplate>
                                </ItemsControl.Resources>
                            </ItemsControl>
                        </ScrollViewer>
                        </Grid>

                            <ScrollViewer x:Name="Pista" Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <Grid Width="{Binding Ancho}" HorizontalAlignment="Left">
                                    <!-- Rejilla de semanas, por detrás de todo -->
                                    <ItemsControl ItemsSource="{Binding Semanas}" VerticalAlignment="Stretch">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="{Binding Ancho}" BorderBrush="#F1F5F9"
                                                        BorderThickness="0,0,1,0"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding Filas}">
                                        <ItemsControl.Resources>
                                            <!-- Las cabeceras de técnico no llevan barra, pero sí
                                                 ocupan su fila para no descuadrar las columnas.
                                                 Su alto tiene que ser el mismo que el de la
                                                 columna de nombres, o las filas se desalinean. -->
                                            <DataTemplate DataType="{x:Type vm:GrupoDeTecnicoViewModel}">
                                                <Border Height="30" Background="#F8FAFC"
                                                        BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"/>
                                            </DataTemplate>

                                            <DataTemplate DataType="{x:Type vm:CarrilViewModel}">
                                                <!--
                                                    Un carril: todos los trabajos que caben en esta
                                                    fila sin pisarse, cada uno en su fecha.

                                                    El panel es una rejilla de una sola celda, de
                                                    modo que los trabajos se superponen y quien los
                                                    separa es su margen izquierdo. Con un StackPanel
                                                    irían pegados uno detrás de otro y las fechas
                                                    dejarían de decir nada.

                                                    El «Carril» marca contra qué se mide el ratón:
                                                    el panel de las tarjetas se desplaza con ellas
                                                    y no sirve de referencia.
                                                -->
                                                <Grid Height="36" local:ArrastreDeBarra.Carril="True">
                                                  <ItemsControl ItemsSource="{Binding Tarjetas}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><Grid/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                      <DataTemplate>
                                                        <!--
                                                            Un trabajo son sus familias, una tarjeta
                                                            cada una y pegadas unas a otras. Cogiendo
                                                            cualquiera se mueven todas; los bordes de
                                                            fuera estiran el trabajo. Una toma de
                                                            notas suelta da una sola tarjeta, así que
                                                            aquí no hay dos casos.
                                                        -->
                                                        <ItemsControl ItemsSource="{Binding Trozos}"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  Margin="{Binding Izquierda,
                                                                           Converter={StaticResource Desplazamiento}}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Command="{Binding Planificar}"
                                                                        local:ArrastreDeBarra.Activo="True"
                                                                        Style="{StaticResource BarraPlan}"
                                                                        Background="{Binding Color}"
                                                                        Width="{Binding Ancho}"
                                                                        ToolTip="{Binding Detalle}">
                                                                    <!--
                                                                        Abrir la toma de notas vivía
                                                                        en el nombre de la izquierda,
                                                                        que desapareció al compartir
                                                                        fila. Va al botón derecho
                                                                        para no estorbar al arrastre,
                                                                        que es del izquierdo.
                                                                    -->
                                                                    <Button.ContextMenu>
                                                                        <ContextMenu>
                                                                            <MenuItem Header="Abrir la toma de notas"
                                                                                      Command="{Binding Abrir}"/>
                                                                            <MenuItem Header="Planificar"
                                                                                      Command="{Binding Planificar}"/>
                                                                        </ContextMenu>
                                                                    </Button.ContextMenu>
                                                                    <!--
                                                                        Rejilla y no StackPanel: dentro de un
                                                                        StackPanel horizontal el ancho es
                                                                        infinito, así que el código se cortaba
                                                                        en seco en vez de terminar en puntos
                                                                        suspensivos. Con la columna «*» el
                                                                        texto sí sabe lo que le queda.
                                                                    -->
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Orientation="Horizontal"
                                                                                    VerticalAlignment="Center">
                                                                            <!-- Caja de cartón: las muestras ya están en el laboratorio -->
                                                                            <Path Data="{StaticResource IconoCaja}"
                                                                                  Stroke="White" StrokeThickness="1.2"
                                                                                  StrokeLineJoin="Round" Margin="0,0,6,0"
                                                                                  VerticalAlignment="Center"
                                                                                  Visibility="{Binding MuestrasRecibidas,
                                                                                               Converter={StaticResource BoolAVisible}}"/>

                                                                            <!-- Candado: estas fechas no las mueve el arrastre -->
                                                                            <Path Data="{StaticResource IconoCandado}"
                                                                                  Stroke="White" StrokeThickness="1.2"
                                                                                  StrokeLineJoin="Round" Margin="0,0,6,0"
                                                                                  VerticalAlignment="Center"
                                                                                  ToolTip="Fechas bloqueadas"
                                                                                  Visibility="{Binding FechasBloqueadas,
                                                                                               Converter={StaticResource BoolAVisible}}"/>
                                                                        </StackPanel>
                                                                        <!--
                                                                            El código manda y las semanas y el
                                                                            porcentaje van detrás, más apagados:
                                                                            el recorte muerde por la cola, así
                                                                            que en una barra estrecha lo que se
                                                                            pierde es el añadido y no el nombre.
                                                                        -->
                                                                        <TextBlock Grid.Column="1"
                                                                                   Foreground="White"
                                                                                   FontSize="11" FontWeight="SemiBold"
                                                                                   VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis">
                                                                            <Run Text="{Binding Codigo, Mode=OneWay}"/><Run
                                                                                   Text="{Binding Extra, Mode=OneWay}"
                                                                                   FontWeight="Normal"
                                                                                   Foreground="#CCFFFFFF"/>
                                                                        </TextBlock>
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                      </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                  </ItemsControl>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.Resources>
                                    </ItemsControl>

                                    <!-- Hoy: lo primero que busca el ojo -->
                                    <Border Width="2" Background="#EF4444" Opacity="0.55"
                                            HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                            IsHitTestVisible="False"
                                            Margin="{Binding PosicionDeHoy, Converter={StaticResource Desplazamiento}}"
                                            Visibility="{Binding HoyVisible, Converter={StaticResource BoolAVisible}}"/>
                                </Grid>
                            </ScrollViewer>
                    </Grid>

                    <!-- Servicios sin fechas: se enseñan aparte para que no se pierdan.
                         Plegable, porque con muchos se comía media pantalla; desplegado por
                         defecto, porque lo que no está planificado es lo que hay que
                         planificar. -->
                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0"
                            Padding="14,6,14,10" Visibility="{Binding HaySinFechas,
                                                        Converter={StaticResource BoolAVisible}}">
                        <StackPanel>
                            <Button Command="{Binding AlternarSinFechas}" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0" Padding="0,4"
                                    HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                    ToolTip="Plegar o desplegar los que están sin planificar">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding MarcaSinFechas}" FontSize="10" FontWeight="Bold"
                                               Foreground="#94A3B8" Margin="0,0,5,0"/>
                                    <TextBlock Text="SIN FECHAS O FUERA DEL PERIODO" FontSize="10"
                                               FontWeight="Bold" Foreground="#94A3B8"/>
                                </StackPanel>
                            </Button>
                            <ItemsControl ItemsSource="{Binding SinFechas}" Margin="0,6,0,0"
                                          Visibility="{Binding SinFechasDesplegado,
                                                       Converter={StaticResource BoolAVisible}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                                                CornerRadius="8" Padding="12,8" Margin="0,0,8,8">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <!-- Muestras ya en el laboratorio y todavía sin
                                                         planificar: eso es lo que corre prisa -->
                                                    <Path Data="{StaticResource IconoCaja}"
                                                          Stroke="#B45309" StrokeThickness="1.2"
                                                          StrokeLineJoin="Round" Margin="0,0,6,0"
                                                          VerticalAlignment="Center"
                                                          ToolTip="Las muestras ya están en el laboratorio"
                                                          Visibility="{Binding MuestrasRecibidas,
                                                                       Converter={StaticResource BoolAVisible}}"/>
                                                    <Button Content="{Binding Codigo}" Command="{Binding Abrir}"
                                                            Style="{StaticResource EnlaceProyecto}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Tecnico}" FontSize="10"
                                                           Foreground="#9CA3AF"/>
                                                <Button Content="Planificar" Command="{Binding Planificar}"
                                                        Padding="10,4" Margin="0,7,0,0" Cursor="Hand"
                                                        HorizontalAlignment="Left" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
                </Grid>
            </Grid>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="#FFFFFF" BorderBrush="#E1E4E8" BorderThickness="0,0,0,1" Padding="6,3">
            <MenuItem Header="_Archivo">
                <MenuItem Header="_Nueva toma de notas" Command="{Binding NuevoProyecto}"
                          ToolTip="Darla de alta con nombre y técnico, para poder planificarla ya"/>
                <Separator/>
                <MenuItem Header="Nueva _pestaña" Command="{Binding NuevaPestana}" InputGestureText="Ctrl+T"/>
                <MenuItem Header="_Abrir toma de notas" Command="{Binding Abrir}" InputGestureText="Ctrl+O"/>
                <MenuItem Header="Tomas de notas _recientes" ItemsSource="{Binding Recientes}"
                          IsEnabled="{Binding HayRecientes}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Etiqueta}"/>
                            <Setter Property="Command"
                                    Value="{Binding DataContext.AbrirReciente,
                                            RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Setter Property="CommandParameter" Value="{Binding Ruta}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator/>
                <!-- Actúan sobre la pestaña de delante -->
                <MenuItem Header="_Guardar" Command="{Binding ActivoDocumento.Guardar}" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Guardar _como" Command="{Binding ActivoDocumento.GuardarComo}"/>
                <Separator/>
                <MenuItem Header="_Exportar toma de notas (html)"
                          Command="{Binding ActivoDocumento.ExportarInforme}" InputGestureText="Ctrl+P"/>
                <Separator/>
                <MenuItem Header="_Cerrar pestaña" Command="{Binding CerrarPestana}"
                          CommandParameter="{Binding Activo}"/>
            </MenuItem>

            <MenuItem Header="_Ver">
                <!-- Salta a una pestaña vacía, o abre una si no queda ninguna: la portada
                     es lo que enseña cualquier pestaña sin proyecto -->
                <MenuItem Header="_Inicio" Command="{Binding VerInicio}"
                          ToolTip="Volver a la portada sin cerrar lo que tengas abierto"/>
                <Separator/>
                <!--
                    El tablero es una pestaña más, y solo una.

                    «Ir a gestión» respeta la vista en la que se estaba —volver desde el
                    menú a media planificación no debe devolverte al tablero—; debajo, las
                    cuatro por su nombre para quien ya sabe adónde va. La marca dice en
                    cuál se está, que es la pregunta que se hace al abrir el menú.
                -->
                <MenuItem Header="_Planificación de TdN y servicios">
                    <MenuItem Header="_Ir a gestión" Command="{Binding IrAGestion}"
                              ToolTip="Abre gestión en la vista en la que estabas"/>
                    <Separator/>
                    <MenuItem Header="_Tablero"
                              Command="{Binding IrAVistaDeGestion}"
                              CommandParameter="{x:Static vm:Vista.Tablero}"
                              IsCheckable="True"
                              IsChecked="{Binding Gestion.VistaTablero, Mode=OneWay}"
                              ToolTip="Qué falta por rellenar, TdN a TdN"/>
                    <MenuItem Header="_Calendario"
                              Command="{Binding IrAVistaDeGestion}"
                              CommandParameter="{x:Static vm:Vista.Calendario}"
                              IsCheckable="True"
                              IsChecked="{Binding Gestion.VistaCalendario, Mode=OneWay}"
                              ToolTip="Cuándo toca cada uno, por semanas y por técnico"/>
                    <MenuItem Header="Car_ga"
                              Command="{Binding IrAVistaDeGestion}"
                              CommandParameter="{x:Static vm:Vista.Carga}"
                              IsCheckable="True"
                              IsChecked="{Binding Gestion.VistaCarga, Mode=OneWay}"
                              ToolTip="Cuánto tiene comprometido cada técnico cada mes"/>
                    <MenuItem Header="_BBDD"
                              Command="{Binding IrAVistaDeGestion}"
                              CommandParameter="{x:Static vm:Vista.Bbdd}"
                              IsCheckable="True"
                              IsChecked="{Binding Gestion.VistaBbdd, Mode=OneWay}"
                              ToolTip="Todas las tomas de notas, con buscador"/>
                </MenuItem>
            </MenuItem>

            <!-- Listas del laboratorio, comunes a todas las tomas de notas -->
            <MenuItem Header="_Configuración">
                <!-- Lo primero: de esta carpeta sale todo lo demás -->
                <!-- El nombre las dice las dos: son la carpeta donde se buscan los
                     proyectos y la compartida, y en una sola ventana no se adivinaba -->
                <MenuItem Header="_Carpetas: tomas de notas y compartida"
                          Command="{Binding ElegirCarpetaDelLaboratorio}"
                          ToolTip="Dónde se buscan las tomas de notas y dónde están las normas, los técnicos y la tarifa"/>
                <Separator/>
                <MenuItem Header="_Técnicos" Command="{Binding EditarTecnicos}"/>
                <MenuItem Header="_Capacidad y tarifa" Command="{Binding EditarCapacidad}"/>
                <Separator/>
                <MenuItem Header="_Normas instaladas" Command="{Binding VerPlantillas}"/>
            </MenuItem>

            <MenuItem Header="A_yuda">
                <MenuItem Header="_Reportar un problema" Command="{Binding ReportarProblema}"
                          ToolTip="A quién avisar cuando algo falla, y con qué datos"/>
                <Separator/>
                <MenuItem Header="_Acerca de" Command="{Binding VerAcercaDe}"/>
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--
                Este equipo se ha quedado con una versión anterior a la del laboratorio.
                Se avisa y se puede quitar de en medio: es un aviso, no un candado.
            -->
            <Border Grid.Row="0" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="0,0,0,1"
                    Padding="16,8"
                    Visibility="{Binding HayVersionMasNueva, Converter={StaticResource BoolAVisible}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Command="{Binding OcultarAvisoDeVersion}"
                            Background="Transparent" BorderThickness="0" Foreground="#92400E"
                            Padding="6,0" Cursor="Hand" ToolTip="Ocultar hasta el próximo arranque"/>
                    <Button DockPanel.Dock="Right" Content="Ver detalles" Command="{Binding VerAcercaDe}"
                            Background="Transparent" BorderThickness="0" Foreground="#92400E"
                            Padding="10,0" Cursor="Hand" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TextoDeVersionMasNueva}" Foreground="#92400E"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <!--
                Barra de pestañas: un proyecto en cada una y el botón de abrir otra
                justo detrás de la última, como en un navegador.
            -->
            <Border Grid.Row="1" Background="#ECEEF1">
            <WrapPanel Margin="6,5,6,0">
                <ItemsControl ItemsSource="{Binding Pestanas}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,4,0" CornerRadius="8,8,0,0" Padding="12,7" MaxWidth="230">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#E0E3E7"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EsActivo}" Value="True">
                                                <Setter Property="Background" Value="#F5F6F8"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding Rotulo}" Cursor="Hand" Padding="0"
                                            Background="Transparent" BorderThickness="0"
                                            HorizontalContentAlignment="Left"
                                            Command="{Binding DataContext.ActivarPestana,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Foreground" Value="#4B5563"/>
                                                <Style.Triggers>
                                                    <!-- La pestaña de delante se lee de un vistazo -->
                                                    <DataTrigger Binding="{Binding EsActivo}" Value="True">
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Foreground" Value="#111827"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="✕" Margin="10,0,0,0" Padding="4,0" Cursor="Hand"
                                            FontSize="11" Background="Transparent" BorderThickness="0"
                                            Foreground="#6B7280" ToolTip="Cerrar la pestaña"
                                            Command="{Binding DataContext.CerrarPestana,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="+" Command="{Binding NuevaPestana}" Cursor="Hand"
                        Style="{StaticResource BotonIcono}"
                        Width="30" Height="30" FontSize="16" FontWeight="Bold"
                        Background="Transparent" BorderThickness="0" Foreground="#374151"
                        ToolTip="Abrir otra toma de notas (Ctrl+T)"/>
            </WrapPanel>
            </Border>

            <ContentControl Grid.Row="2" Content="{Binding Activo}"/>
        </Grid>



        <!--
            Aquí iba la franja oscura del pie de ventana. Se quitó el 2026‑08‑06 (DD‑133):
            ocupaba sitio en todas las pantallas para no decir nada casi nunca.

            Lo que se decía por ahí se repartió. Lo que **falla** va a una ventana
            —`ServiciosDeVentana.Avisar`—, porque un «no se pudo guardar» tiene que
            interrumpir; las **confirmaciones** se quitaron, porque ya se veían por otro
            lado: la ruta está bajo el título, el punto de «sin guardar» desaparece solo al
            guardar y el informe exportado se abre en el visor.

            La fila 2 se deja declarada: si algún día vuelve a hacer falta algo fijo abajo
            —una barra de progreso, por ejemplo— tiene sitio sin retocar la rejilla.
        -->
    </Grid>
</Window>
