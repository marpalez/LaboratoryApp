<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LumNotas.Core\LumNotas.Core.csproj" />
    <ProjectReference Include="..\LumNotas.Storage\LumNotas.Storage.csproj" />
    <ProjectReference Include="..\LumNotas.Report\LumNotas.Report.csproj" />
  </ItemGroup>

  <!-- La plantilla y el catálogo viajan junto al ejecutable: así el .exe funciona
       en cualquier carpeta sin depender de la estructura del proyecto. -->
  <ItemGroup>
    <Content Include="..\..\plantilla\*.json"
             Link="plantilla\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!--
      El ejecutable se llama como el programa, no como el proyecto. Se llamaba
      «LumNotas.App.exe» y eso es lo que veía el técnico en la barra de tareas, en el
      acceso directo y en el administrador de tareas.
    -->
    <AssemblyName>LumenLab</AssemblyName>
    <ApplicationIcon>LumenLab.ico</ApplicationIcon>

    <!--
      Lo que Windows enseña en «Propiedades» del fichero. Sin esto, la descripción era
      «LumNotas.App» —el nombre del proyecto— y el copyright iba en blanco.
    -->
    <AssemblyTitle>LumenLab</AssemblyTitle>
    <Copyright>© 2026 David Martínez Palomares (DMP) · davidmarpalez.com</Copyright>

    <!--
      El día que esto entre en git, .NET añadiría el identificador del commit a la versión
      informativa —«1.0.0+a3f9c1»— y el programa la enseña cruda en la portada y en «Acerca
      de». La comparación con la publicada sí sabe limpiarla; el cartel no.
    -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!--
    ESTE NÚMERO HAY QUE SUBIRLO EN CADA ENTREGA.
    Es el que sale en «Ayuda | Acerca de» y con el que se compara la versión que el
    laboratorio ha publicado en la carpeta compartida. Si no se sube, los demás equipos
    no se enteran de que hay una versión nueva.
  -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <!--
      El nombre del programa está aquí y solo aquí: la portada y «Acerca de» lo leen del
      ejecutable. Ya no se llama por lo que hacía al principio, porque hace dos cosas:
      tomar notas de ensayo y gestionar los proyectos.
    -->
    <Product>LumenLab</Product>

    <!--
      Quien lo firma, no quien lo usa. Windows enseña esto como «Empresa» en las
      propiedades del fichero, que es el sitio donde se mira de dónde salió un ejecutable:
      ahí tiene que estar el autor. El laboratorio es el destinatario, y eso ya se ve en
      todo lo demás.
    -->
    <Company>David Martínez Palomares (DMP)</Company>
  </PropertyGroup>

</Project>
