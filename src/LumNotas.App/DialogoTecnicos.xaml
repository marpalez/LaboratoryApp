<Window x:Class="LumNotas.App.DialogoTecnicos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Técnicos del laboratorio"
        SizeToContent="Height" Width="480" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" Background="White">

    <StackPanel Margin="26,22">
        <TextBlock Text="Técnicos del laboratorio" FontSize="17" FontWeight="Bold" Foreground="#111827"/>
        <TextBlock x:Name="Explicacion" Margin="0,4,0,16" Foreground="#6B7280" FontSize="12"
                   TextWrapping="Wrap"/>

        <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="1">
            <ListBox x:Name="Lista" Height="220" BorderThickness="0"
                     SelectionChanged="AlCambiarSeleccion"/>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <TextBox x:Name="Nombre" Width="250" Padding="5,4" VerticalAlignment="Center"
                     KeyDown="AlTeclearNombre"/>
            <Button Content="Añadir" Click="AlAnadir" Padding="14,5" Margin="8,0,0,0" Cursor="Hand"/>
            <Button x:Name="BotonRenombrar" Content="Corregir" Click="AlRenombrar" Padding="14,5"
                    Margin="6,0,0,0" Cursor="Hand" IsEnabled="False"
                    ToolTip="Corrige el nombre del técnico seleccionado, también en sus proyectos"/>
            <Button x:Name="BotonQuitar" Content="Quitar" Click="AlQuitar" Padding="14,5"
                    Margin="6,0,0,0" Cursor="Hand" IsEnabled="False"
                    ToolTip="Lo saca de la lista; los proyectos que ya lo llevan no cambian"/>
        </StackPanel>

        <TextBlock x:Name="Aviso" Foreground="#B45309" FontSize="12" TextWrapping="Wrap"
                   Margin="0,12,0,0" Visibility="Collapsed"/>

        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8"
                Padding="14,10" Margin="0,16,0,0">
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#4B5563"
                       Text="Quitar a un técnico no cambia ningún proyecto: el ensayo lo hizo esa persona. Corregir su nombre sí se aplica a los proyectos que lo lleven, porque una errata no es una persona distinta."/>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cerrar" Click="AlCerrar" IsDefault="True" IsCancel="True"
                    Padding="18,9" Cursor="Hand"
                    Background="#2563EB" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </StackPanel>
</Window>
