<Window x:Class="LumNotas.App.DialogoCarpeta"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Carpetas del laboratorio"
        SizeToContent="Height" Width="580" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" Background="White">

    <Window.Resources>
        <Style TargetType="Border" x:Key="Ficha">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="26,22">
        <TextBlock Text="Carpetas del laboratorio" FontSize="17" FontWeight="Bold" Foreground="#111827"/>
        <TextBlock Margin="0,4,0,18" Foreground="#6B7280" FontSize="12" TextWrapping="Wrap"
                   Text="Son dos carpetas distintas de OneDrive. Se eligen una vez en cada equipo."/>

        <!-- ===== 1. Proyectos ===== -->
        <TextBlock Text="1 · Dónde están los proyectos" FontWeight="SemiBold" Foreground="#374151"
                   Margin="0,0,0,4"/>
        <TextBlock Margin="0,0,0,6" Foreground="#6B7280" FontSize="11" TextWrapping="Wrap"
                   Text="La carpeta que los contiene a todos, aunque cada uno cuelgue de su cliente y su servicio. Se busca dentro de ella y de todas sus subcarpetas."/>

        <Border x:Name="EstadoProyectos" Style="{StaticResource Ficha}">
            <StackPanel>
                <TextBlock x:Name="TituloProyectos" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="RutaProyectos" FontSize="11" Foreground="#4B5563" Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Button Content="Elegir carpeta de proyectos…" Click="AlElegirProyectos" Padding="14,7"
                Cursor="Hand" HorizontalAlignment="Left" Margin="0,0,0,20"/>

        <!-- ===== 2. Configuración compartida ===== -->
        <TextBlock Text="2 · Dónde está lo compartido" FontWeight="SemiBold" Foreground="#374151"
                   Margin="0,0,0,4"/>
        <TextBlock Margin="0,0,0,6" Foreground="#6B7280" FontSize="11" TextWrapping="Wrap"
                   Text="Las normas, la lista de técnicos, la tarifa y la versión del programa. Tiene que poder leerla todo el mundo. Si se deja en blanco, se usa la de proyectos."/>

        <Border x:Name="EstadoCompartida" Style="{StaticResource Ficha}">
            <StackPanel>
                <TextBlock x:Name="TituloCompartida" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="RutaCompartida" FontSize="11" Foreground="#4B5563" Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
                <StackPanel x:Name="Contenido" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Button Content="Elegir carpeta compartida…" Click="AlElegirCompartida" Padding="14,7"
                    Cursor="Hand"/>
            <Button x:Name="BotonUsarProyectos" Content="Usar la de proyectos" Click="AlUsarProyectos"
                    Padding="14,7" Margin="8,0,0,0" Cursor="Hand"
                    ToolTip="Deja la carpeta compartida en blanco: se usará la de proyectos"/>
        </StackPanel>

        <TextBlock x:Name="Aviso" Foreground="#B45309" FontSize="12" TextWrapping="Wrap"
                   Margin="0,0,0,12" Visibility="Collapsed"/>

        <Button Content="Cerrar" Click="AlCerrar" IsDefault="True" IsCancel="True"
                HorizontalAlignment="Right" Padding="18,9" Cursor="Hand"
                Background="#2563EB" Foreground="White" BorderThickness="0"/>
    </StackPanel>
</Window>
