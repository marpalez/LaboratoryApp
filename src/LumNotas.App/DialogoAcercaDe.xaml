<Window x:Class="LumNotas.App.DialogoAcercaDe"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acerca de"
        SizeToContent="Height" Width="500" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" Background="White">

    <StackPanel Margin="26,22">
        <!-- El nombre lo pone el código, leído del ejecutable: escrito aquí acabaría
             diciendo una cosa distinta de la portada -->
        <TextBlock x:Name="Nombre" FontSize="17" FontWeight="Bold" Foreground="#111827"/>
        <TextBlock x:Name="Version" Margin="0,4,0,16" Foreground="#6B7280" FontSize="12"/>

        <Border x:Name="Estado" CornerRadius="8" Padding="14,12" BorderThickness="1" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="Titulo" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="Detalle" FontSize="12" Foreground="#4B5563" Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TextBlock Text="Normas cargadas" Foreground="#374151" FontSize="12" FontWeight="SemiBold"
                   Margin="0,0,0,6"/>
        <TextBlock x:Name="Normas" FontSize="12" Foreground="#4B5563" TextWrapping="Wrap"
                   LineHeight="19" Margin="0,0,0,6"/>
        <TextBlock x:Name="OrigenNormas" FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap"
                   Margin="0,0,0,16"/>

        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8"
                Padding="14,10" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Publicar la versión de programa existente en este PC como la oficial del laboratorio"
                           FontWeight="SemiBold" TextWrapping="Wrap"
                           FontSize="12" Foreground="#374151"/>
                <!--
                    El texto dice lo que pasa HOY, no lo que pasará con el instalador
                    automático: hoy solo se deja anotado el número y cada equipo se
                    actualiza a mano. Prometer aquí que se instala solo dejaría a un
                    técnico esperando una actualización que no llega.
                    Cuando esté ClickOnce, esta última frase se cambia y ya está.
                -->
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#6B7280" Margin="0,4,0,8"
                           Text="Hazlo cuando instales una versión actualizada de LumenLab. El resto de equipos siguen con la suya y al arrancar verán un aviso de que hay una más nueva. De momento la instalación es manual en cada equipo; cuando esté el instalador automático se actualizarán y se reiniciarán solos."/>

                <!-- La caja estaba sin rótulo y no se sabía qué escribir en ella. -->
                <TextBlock Text="Qué cambia en esta versión (opcional)" FontSize="11"
                           Foreground="#6B7280" Margin="0,0,0,3"/>
                <TextBox x:Name="Notas" Padding="5,4" Margin="0,0,0,8"
                         ToolTip="Se les enseña a los demás junto al aviso de versión nueva"/>
                <Button x:Name="BotonPublicar" Content="Publicar esta versión" Click="AlPublicar"
                        Padding="14,6" Cursor="Hand" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="Resultado" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                   Foreground="#15803D" Visibility="Collapsed"/>

        <Button Content="Cerrar" Click="AlCerrar" IsDefault="True" IsCancel="True"
                HorizontalAlignment="Right" Padding="18,9" Cursor="Hand"
                Background="#2563EB" Foreground="White" BorderThickness="0"/>
    </StackPanel>
</Window>
