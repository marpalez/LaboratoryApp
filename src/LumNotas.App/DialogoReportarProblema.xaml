<Window x:Class="LumNotas.App.DialogoReportarProblema"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reportar un problema"
        SizeToContent="Height" Width="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" Background="White">

    <StackPanel Margin="26,22">
        <TextBlock Text="Reportar un problema" FontSize="17" FontWeight="Bold" Foreground="#111827"/>
        <TextBlock Margin="0,4,0,18" Foreground="#6B7280" FontSize="12" TextWrapping="Wrap"
                   Text="Cuenta qué estabas haciendo y qué esperabas que pasara. Si el programa dio un error, dilo tal cual salió."/>

        <!-- El correo, en grande: es lo que se viene a buscar aquí -->
        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8"
                Padding="16,14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="ESCRIBE A" FontWeight="Bold" FontSize="11" Foreground="#1D4ED8"
                           Margin="0,0,0,6"/>
                <!-- Seleccionable: en un equipo sin cliente de correo configurado, copiarlo
                     a mano es la única salida -->
                <TextBox x:Name="Correo" IsReadOnly="True" BorderThickness="0"
                         Background="Transparent" Padding="0" FontSize="15" FontWeight="SemiBold"
                         Foreground="#1E3A8A"/>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <Button Content="Escribir el correo" Click="AlEscribir" Padding="16,8" Cursor="Hand"
                    Background="#2563EB" Foreground="White" BorderThickness="0"
                    ToolTip="Abre tu programa de correo con los datos ya puestos"/>
            <Button x:Name="BotonCopiar" Content="Copiar dirección" Click="AlCopiar"
                    Padding="14,8" Margin="8,0,0,0" Cursor="Hand"/>
        </StackPanel>

        <!--
            Sin estos tres datos casi ningún fallo se puede reproducir, y pedírselos luego
            por correo es una vuelta más. Van copiables de una vez.
        -->
        <TextBlock Text="ADJUNTA ESTOS DATOS" FontWeight="Bold" FontSize="11" Foreground="#9CA3AF"
                   Margin="0,0,0,6"/>
        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8"
                Padding="14,12" Margin="0,0,0,8">
            <TextBox x:Name="Datos" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                     Padding="0" FontFamily="Consolas" FontSize="12" Foreground="#374151"
                     TextWrapping="Wrap" AcceptsReturn="True"/>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button x:Name="BotonCopiarDatos" Content="Copiar los datos" Click="AlCopiarDatos"
                    Padding="14,7" Cursor="Hand"/>
            <Button x:Name="BotonRegistro" Content="Abrir el registro de errores" Click="AlAbrirRegistro"
                    Padding="14,7" Margin="8,0,0,0" Cursor="Hand"
                    ToolTip="El fichero donde el programa apunta los fallos"/>
        </StackPanel>

        <TextBlock x:Name="Aviso" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                   Visibility="Collapsed"/>

        <Button Content="Cerrar" Click="AlCerrar" IsDefault="True" IsCancel="True"
                HorizontalAlignment="Right" Padding="18,9" Cursor="Hand"
                Background="#2563EB" Foreground="White" BorderThickness="0"/>
    </StackPanel>
</Window>
