<Window x:Class="LumNotas.App.DialogoCerrarProyecto"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cerrar la toma de notas"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" Background="White">

    <StackPanel Margin="28,24" MaxWidth="460">
        <TextBlock Text="¿Pasar la TdN a terminado?" FontSize="17" FontWeight="Bold"
                   Foreground="#111827" TextWrapping="Wrap"/>

        <!-- Por qué sale ahora: sin decirlo, una ventana que aparece sola desconcierta. -->
        <TextBlock x:Name="TextoMotivo" Margin="0,8,0,4" Foreground="#6B7280" FontSize="12"
                   TextWrapping="Wrap"/>

        <TextBlock Margin="0,0,0,22" Foreground="#6B7280" FontSize="12" TextWrapping="Wrap"
                   Text="Terminado lo deja marcado como acabado y sigue viéndose en el calendario. Archivado además lo retira de la línea de tiempo; no borra nada, y vuelve a salir eligiendo «Archivados» en los filtros."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Click="AlCancelar" IsCancel="True"
                    Padding="18,9" Margin="0,0,10,0" Cursor="Hand"
                    Background="#E5E7EB" Foreground="#374151" BorderThickness="0"/>
            <Button Content="Pasar a archivado" Click="AlArchivar"
                    Padding="18,9" Margin="0,0,10,0" Cursor="Hand"
                    Background="#E5E7EB" Foreground="#374151" BorderThickness="0"/>
            <Button Content="Pasar a terminado" Click="AlTerminar" IsDefault="True"
                    Padding="18,9" Cursor="Hand"
                    Background="#16A34A" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </StackPanel>
</Window>
