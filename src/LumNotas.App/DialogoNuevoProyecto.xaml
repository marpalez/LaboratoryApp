<Window x:Class="LumNotas.App.DialogoNuevoProyecto"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nueva toma de notas"
        SizeToContent="Height" Width="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Loaded="AlAbrirse"
        FontFamily="Segoe UI" FontSize="13" Background="White">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Etiqueta">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Opcional">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- El rótulo menudo de la ventana de planificación, para que las dos se parezcan -->
        <Style TargetType="TextBlock" x:Key="Rotulo">
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Seccion">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#0F766E"/>
        </Style>
    </Window.Resources>

    <!--
        Dos zonas: el formulario se desplaza y los botones no. Estando todo dentro del
        mismo ScrollViewer, con lo opcional abierto había que bajar hasta el final para
        llegar a «Crear» — y el botón principal de una ventana no puede esconderse.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="26,22,26,10">
        <TextBlock Text="Nueva toma de notas" FontSize="17" FontWeight="Bold" Foreground="#111827"/>
        <TextBlock Margin="0,3,0,12" Foreground="#6B7280" FontSize="12" TextWrapping="Wrap"
                   Text="Con lo obligatorio ya se puede planificar. En rojo, lo que falta."/>

        <!-- ======================= OBLIGATORIA ======================= -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Border Width="4" Height="14" CornerRadius="2" Background="#0F766E" Margin="0,0,9,0"/>
            <TextBlock Text="INFORMACIÓN OBLIGATORIA" Style="{StaticResource Seccion}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!--
            El rótulo se pone rojo mientras el campo esté vacío, igual que las casillas
            obligatorias de la toma de notas: así se ve qué falta sin leer el aviso de abajo.
            El ejemplo se fue al hueco de la propia caja, que dice lo mismo sin gastar línea.
        -->
        <TextBlock x:Name="EtiquetaNombre" Text="Código de la toma de notas"
                   Style="{StaticResource Etiqueta}"/>
        <!-- Fijo, siempre a la vista: quien da de alta el proyecto es quien decide cómo se
             codifica, y tiene que poder copiar el patrón sin buscarlo. -->
        <TextBlock Text="Ejemplo: TECNO260201-00" Style="{StaticResource Opcional}"/>
        <TextBox x:Name="Nombre" Padding="6,5" Margin="0,0,0,2" TextChanged="AlEscribir"/>
        <TextBlock x:Name="Derivado" Style="{StaticResource Opcional}" Margin="0,0,0,10"/>

        <!-- Responsable y norma, en dos columnas: los dos son un desplegable corto -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock x:Name="EtiquetaTecnico" Text="Técnico 1 · responsable"
                           Style="{StaticResource Etiqueta}"/>
                <ComboBox x:Name="Tecnico1" Padding="6,5" SelectionChanged="AlElegirTecnico"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock x:Name="EtiquetaNorma" Text="Norma" Style="{StaticResource Etiqueta}"/>
                <ComboBox x:Name="Norma" Padding="6,5" DisplayMemberPath="Titulo"
                          SelectionChanged="AlElegirNorma"
                          ToolTip="Con la que se va a ensayar. Es la que el tablero detalla y la que da nombre al fichero"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="EtiquetaCarpeta" Text="Carpeta" Style="{StaticResource Etiqueta}"/>
        <!-- El .lmnlab es el registro del ensayo: tiene que quedar donde le corresponde
             en el árbol de clientes, no en cualquier sitio. Empieza vacía a propósito —
             para que se vea que hay que elegirla—, aunque el examinador se abra ya en la
             carpeta de proyectos. La explicación se fue al consejo emergente. -->
        <DockPanel Margin="0,0,0,12"
                   ToolTip="La carpeta de tomas de notas de ese servicio, dentro de la del cliente">
            <Button DockPanel.Dock="Right" Content="Examinar" Click="AlElegirCarpeta"
                    Padding="14,6" Margin="8,0,0,0" Cursor="Hand"/>
            <TextBox x:Name="Carpeta" Padding="6,5" IsReadOnly="True" Background="#F9FAFB"
                     TextChanged="AlEscribir" TextWrapping="NoWrap"/>
        </DockPanel>

        <!-- ======================== OPCIONAL ========================= -->
        <!--
            Plegada por defecto. El alta es corta a propósito (DD‑83, DD‑85): el
            responsable crea la tarjeta en cuatro segundos y el técnico rellena el resto.
            Desplegada de serie, esos cuatro segundos se convertirían en un formulario.
        -->
        <Expander x:Name="Opcionales" IsExpanded="False" Margin="0,0,0,4"
                  Expanded="AlPlegarODesplegar" Collapsed="AlPlegarODesplegar">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <Border Width="4" Height="14" CornerRadius="2" Background="#9CA3AF" Margin="0,0,9,0"/>
                    <TextBlock Text="INFORMACIÓN OPCIONAL" Style="{StaticResource Seccion}"
                               Foreground="#6B7280" VerticalAlignment="Center"/>
                </StackPanel>
            </Expander.Header>

            <StackPanel Margin="0,10,0,0">
                <TextBlock Text="Técnico 2" Style="{StaticResource Etiqueta}"/>
                <ComboBox x:Name="Tecnico2" Padding="6,5" Margin="0,0,0,12"
                          ToolTip="Hay servicios con un solo técnico"/>

                <TextBlock Text="Las fechas son solo del calendario; no tocan ningún dato de ensayo."
                           Style="{StaticResource Opcional}" Margin="0,0,0,8"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Inicio previsto" Style="{StaticResource Rotulo}"/>
                        <DatePicker x:Name="Inicio" SelectedDateChanged="AlCambiarFecha"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Fin previsto" Style="{StaticResource Rotulo}"/>
                        <DatePicker x:Name="Fin" SelectedDateChanged="AlCambiarFecha"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,-6,0,6">
                    <TextBlock x:Name="Semana" Foreground="#6B7280" FontSize="11" VerticalAlignment="Center"/>
                    <Button x:Name="BotonQuitarFechas" Content="Quitar fechas" Click="AlQuitarFechas"
                            HorizontalAlignment="Right" Padding="10,3" FontSize="11" Cursor="Hand"
                            ToolTip="Deja el servicio como pendiente de planificar"/>
                </Grid>

                <!-- El mismo candado que el diálogo de planificación: lo comprometido con
                     el cliente no lo mueve ni el arrastre ni la cadena de un grupo. -->
                <CheckBox x:Name="Bloquear" Content="Bloquear fechas" Click="AlBloquear"
                          Margin="0,0,0,12" Cursor="Hand"
                          ToolTip="Impide cambiarlas aquí, arrastrando la tarjeta y al recolocar un trabajo agrupado"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Estado" Style="{StaticResource Rotulo}"/>
                        <ComboBox x:Name="Estado" DisplayMemberPath="Etiqueta" SelectedValuePath="Valor"/>
                    </StackPanel>

                    <!-- De aquí sale el trabajo del servicio para la vista de carga -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Importe de la oferta (€)" Style="{StaticResource Rotulo}"/>
                        <TextBox x:Name="Importe" Padding="5,4" TextChanged="AlCambiarImporte"/>
                        <TextBlock x:Name="Trabajo" FontSize="10" Foreground="#6B7280" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>

                <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8"
                        Padding="12,10" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="Recibidas" Content="Las muestras ya han llegado"
                                  Checked="AlMarcarRecibidas" Unchecked="AlMarcarRecibidas"/>
                        <StackPanel x:Name="ZonaRecepcion" Orientation="Horizontal" Margin="22,8,0,0">
                            <TextBlock Text="Fecha de recepción" Style="{StaticResource Rotulo}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <DatePicker x:Name="Recepcion" Width="150"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Enlazar las familias de un mismo servicio. No hay fichero de grupo:
                     el enlace vive dentro de cada toma de notas (DD‑89, DD‑90). -->
                <TextBlock Text="Grupo" Style="{StaticResource Rotulo}"/>
                <TextBox x:Name="Grupo" Padding="5,4" TextChanged="AlCambiarGrupo"
                         ToolTip="El mismo nombre en las tomas de notas del mismo trabajo: el calendario las enseñará como una sola barra"/>
                <TextBlock x:Name="AvisoGrupo"
                           Text="El mismo nombre en las familias de un servicio y el calendario las enseña juntas."
                           Foreground="#9CA3AF" FontSize="11" Margin="0,4,0,4" TextWrapping="Wrap"/>
            </StackPanel>
        </Expander>

    </StackPanel>
    </ScrollViewer>

    <!-- Siempre a la vista, pase lo que pase con el desplazamiento -->
    <Border Grid.Row="1" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0"
            Padding="26,14">
        <StackPanel>
            <!-- Solo para lo que ha ido mal. La lista de campos que faltan se fue: los
                 rótulos ya se ponen en rojo y «Crear» está apagado. -->
            <TextBlock x:Name="Aviso" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                       Foreground="#B45309" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Click="AlCerrar" IsCancel="True" Padding="18,9" Cursor="Hand"/>
                <Button x:Name="BotonCrear" Content="Crear" Click="AlCrear" IsDefault="True"
                        Padding="22,9" Margin="8,0,0,0" Cursor="Hand"
                        Background="#0F766E" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </StackPanel>
    </Border>
    </Grid>
</Window>
