<Window x:Class="LumNotas.App.DialogoPlantillas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Normas instaladas"
        SizeToContent="Height" Width="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" Background="White">

    <StackPanel Margin="26,22">
        <TextBlock Text="Normas instaladas" FontSize="17" FontWeight="Bold" Foreground="#111827"/>
        <TextBlock Margin="0,4,0,16" Foreground="#6B7280" FontSize="12" TextWrapping="Wrap"
                   Text="Las normas deben ser las mismas en todos los equipos. Si cada uno lleva su copia, dos técnicos pueden rellenar versiones distintas de la misma norma sin enterarse."/>

        <Border x:Name="Estado" CornerRadius="8" Padding="14,12" Margin="0,0,0,16"
                BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="Titulo" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="Ruta" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="Aviso" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="#B45309" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <TextBlock Text="Normas encontradas" Foreground="#374151" FontSize="12" Margin="0,0,0,6"/>
        <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="1">
            <ItemsControl x:Name="Normas" MaxHeight="180">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="12,7">
                            <TextBlock Text="{Binding Titulo}" Foreground="#1F2937"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,80,0"/>
                            <TextBlock Text="{Binding Version}" HorizontalAlignment="Right"
                                       FontSize="11" Foreground="#6B7280"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Lo que hay en este equipo y el laboratorio todavía no tiene. En ámbar y
             pegado al botón de publicar, que es lo que hay que hacer con ello. -->
        <Border x:Name="SinPublicarCaja" Background="#FEF3C7" BorderBrush="#FDE68A"
                BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,12,0,0"
                Visibility="{Binding Visibility, ElementName=SinPublicar}">
            <TextBlock x:Name="SinPublicar" FontSize="12" Foreground="#92400E"
                       TextWrapping="Wrap" Visibility="Collapsed"/>
        </Border>

        <TextBlock x:Name="Resultado" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"
                   Foreground="#15803D" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="BotonPublicar" Content="Publicar en la carpeta compartida"
                    Click="AlPublicar" Padding="14,9" Margin="0,0,10,0" Cursor="Hand"
                    ToolTip="Copia las normas de este equipo a la carpeta compartida, para que las use todo el laboratorio"/>
            <Button Content="Cerrar" Click="AlCerrar" IsDefault="True" IsCancel="True"
                    Padding="18,9" Cursor="Hand"
                    Background="#2563EB" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </StackPanel>
</Window>
